    "import sys, os\n",
    "sys.path.insert(0, os.getcwd())  # main project dir, where sky_plot.py / curve_io.py live\n",
    "\n",
    "from curve_io import load_sky_snr_data\n",
    "from sky_plot import plot_cgw_analysis\n",
    "from types import SimpleNamespace\n",
    "\n",
    "data = load_sky_snr_data('data/2026-08-14/optimistic/sky_sensitivity_data/')\n",
    "\n",
    "binaries = [SimpleNamespace(ra=ra, dec=dec) for ra, dec in zip(data['ra'], data['dec'])]\n",
    "psrs = [SimpleNamespace(phi=phi, theta=theta)\n",
    "        for phi, theta in zip(data['psr_phi'], data['psr_theta'])]\n",
    "\n",
    "plot_cgw_analysis(\n",
    "    binaries=binaries,\n",
    "    snrs=data['cgw_snrs_optimal'],\n",
    "    psrs=psrs,\n",
    "    save_path='/figures/',\n",
    ")"
   ]
