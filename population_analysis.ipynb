   "source": [
    "import numpy as np\n",
    "\n",
    "df = cgw_threshold_sim_df.copy()\n",
    "df['R'] = df['loudest_cgw_snr'] / df['loudest_h0']\n",
    "\n",
    "log_h0 = np.log10(df['loudest_h0'].to_numpy())\n",
    "\n",
    "# Find the valley between the two modes via a smoothed KDE (no sklearn needed)\n",
    "from scipy.stats import gaussian_kde\n",
    "kde = gaussian_kde(log_h0, bw_method=0.15)\n",
    "grid = np.linspace(log_h0.min(), log_h0.max(), 500)\n",
    "density = kde(grid)\n",
    "\n",
    "from scipy.signal import argrelmin, argrelmax\n",
    "minima_idx = argrelmin(density)[0]\n",
    "maxima_idx = argrelmax(density)[0]\n",
    "\n",
    "print(\"peaks at:\", grid[maxima_idx])\n",
    "print(\"valley(s) at:\", grid[minima_idx])\n",
    "\n",
    "# pick the deepest valley between the two tallest peaks as the split point\n",
    "split_point = grid[minima_idx[np.argmin(density[minima_idx])]]\n",
    "print(f\"split at log10(h0) = {split_point:.3f}\")\n",
    "\n",
    "df['mode'] = np.where(log_h0 < split_point, 'B', 'A')"
   ]
  },
