   "source": [
    "import matplotlib.pyplot as plt\n",
    "from apj_style import apply_apj_style, APJ_FIGSIZE\n",
    "from curve_io import load_curves\n",
    "\n",
    "apply_apj_style()\n",
    "arrays, meta = load_curves('data/sensitivity_curves/run01')\n",
    "\n",
    "fig, ax = plt.subplots(figsize=APJ_FIGSIZE)\n",
    "\n",
    "baseline = meta['baseline_name']\n",
    "\n",
    "# No more hardcoded black for the baseline -- everything (baseline\n",
    "# included) now pulls from matplotlib's default color cycle in order,\n",
    "# falling back to that cycle for any scenario without an explicit entry\n",
    "# in meta['colors'].\n",
    "# color_cycle = plt.rcParams['axes.prop_cycle'].by_key()['color']\n",
    "default_colors = ['crimson', 'teal', 'purple']\n",
    "ax.loglog(arrays[baseline]['freqs'], arrays[baseline]['hc_det'],\n",
    "          color=meta['colors'].get(baseline, default_colors[0]), lw=1.3,\n",
    "          label=meta['labels'][baseline])\n",
    "\n",
    "for i, (name, d) in enumerate(\n",
    "        (n, d) for n, d in arrays.items() if n != baseline):\n",
    "    color = meta['colors'].get(name, default_colors[(i + 1) % len(default_colors)])\n",
    "    ax.loglog(d['freqs'], d['hc_det'], color=color, lw=1.0,\n",
    "               label=meta['labels'][name])\n",
    "\n",
    "ax.set_xlabel('Frequency [Hz]')\n",
    "ax.set_ylabel('Characteristic\\nstrain $h_c$')\n",
    "ax.set_xlim(1e-9, 3e-7)\n",
    "ax.tick_params(which='both', direction='in', top=True, right=True)\n",
    "ax.grid(which='both', ls='--', lw=0.3, alpha=0.3)\n",
    "\n",
    "# `loc` needs to be set explicitly alongside bbox_to_anchor -- without it,\n",
    "# loc defaults to 'best' and fights the anchor instead of using it as the\n",
    "# anchor point. 'upper center' + bbox y < 0 puts the legend's top edge at\n",
    "# that anchor, i.e. centered below the axes.\n",
    "legend = ax.legend(frameon=False, ncol=3, handlelength=1.2,\n",
    "                    columnspacing=0.7, handletextpad=0.35,\n",
    "                    loc='upper center', bbox_to_anchor=(0.5, -0.18))\n",
    "\n",
    "# tight_layout() doesn't know about artists placed outside the axes bbox\n",
    "# (like this legend), so it can clip it. Reserve space at the bottom\n",
    "# explicitly instead of relying on tight_layout, and pass the legend as\n",
    "# an extra artist to savefig's bbox calculation so it's never cut off.\n",
    "fig.subplots_adjust(bottom=0.28)\n",
    "\n",
    "# When saving, use bbox_inches='tight' with bbox_extra_artists so the\n",
    "# legend is included in the trim/crop -- otherwise a saved PDF/PNG can\n",
    "# still clip it even with subplots_adjust reserving room on screen:\n",
    "fig.savefig('figures/sensitivity_curves.pdf',\n",
    "            bbox_extra_artists=(legend,), bbox_inches='tight')"
   ]
  },
