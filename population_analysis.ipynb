   ],
   "source": [
    "from collections import defaultdict\n",
    "from pathlib import Path\n",
    "import gzip\n",
    "import json\n",
    "import re\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Configuration\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "RUNS_ROOT = Path(\"runs\")\n",
    "\n",
    "# Store these outside an individual dated run so they are easy to reuse\n",
    "# when launching a new set of simulations.\n",
    "OUTPUT_DIR = Path(\"config\") / \"cgw_cadence_weights\"\n",
    "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "CONFIGURATIONS = (\n",
    "    \"optimistic\",\n",
    "    \"realistic\",\n",
    "    \"pessimistic\",\n",
    ")\n",
    "\n",
    "# The current Stage 2 code stores the baseline breakdown here.\n",
    "BREAKDOWN_FILENAME = \"top_cgw_breakdowns.json\"\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Configuration and file helpers\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "def infer_population_configuration(sim_dir):\n",
    "    \"\"\"\n",
    "    Infer optimistic/realistic/pessimistic from the simulation path.\n",
    "\n",
    "    Examples:\n",
    "        runs/2026-07-16_optimistic/sim000 -> optimistic\n",
    "        runs/2026-07-19_realistic/sim000   -> realistic\n",
    "    \"\"\"\n",
    "    sim_dir = Path(sim_dir)\n",
    "\n",
    "    # Prefer the parent run-directory name.\n",
    "    candidates = [\n",
    "        sim_dir.name,\n",
    "        sim_dir.parent.name,\n",
    "        str(sim_dir),\n",
    "    ]\n",
    "\n",
    "    for text in candidates:\n",
    "        match = re.search(\n",
    "            r\"(?:^|[_-])(optimistic|realistic|pessimistic)\"\n",
    "            r\"(?:$|[_-])\",\n",
    "            text.lower(),\n",
    "        )\n",
    "        if match:\n",
    "            return match.group(1)\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "def find_simulation_directories(runs_root):\n",
    "    \"\"\"\n",
    "    Return completed simulation directories containing summary.pkl.gz.\n",
    "    \"\"\"\n",
    "    return sorted({\n",
    "        summary.parent\n",
    "        for summary in Path(runs_root).rglob(\"summary.pkl.gz\")\n",
    "    })\n",
    "\n",
    "\n",
    "def load_top_breakdowns(sim_dir):\n",
    "    \"\"\"\n",
    "    Load the baseline CGW breakdowns for one simulation.\n",
    "    \"\"\"\n",
    "    path = Path(sim_dir) / \"metadata\" / BREAKDOWN_FILENAME\n",
    "\n",
    "    if not path.is_file():\n",
    "        return []\n",
    "\n",
    "    try:\n",
    "        with path.open() as fh:\n",
    "            records = json.load(fh)\n",
    "    except (OSError, json.JSONDecodeError) as exc:\n",
    "        print(f\"Skipping {path}: {exc}\")\n",
    "        return []\n",
    "\n",
    "    if not isinstance(records, list):\n",
    "        print(f\"Skipping {path}: expected a JSON list\")\n",
    "        return []\n",
    "\n",
    "    return records\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Contribution processing\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "def select_loudest_breakdown(records):\n",
    "    \"\"\"\n",
    "    Select the loudest saved CGW source in one simulation.\n",
    "    \"\"\"\n",
    "    usable = []\n",
    "\n",
    "    for record in records:\n",
    "        if not isinstance(record, dict):\n",
    "            continue\n",
    "\n",
    "        per_pulsar = record.get(\"per_pulsar_rho_sq\")\n",
    "        if not isinstance(per_pulsar, dict) or not per_pulsar:\n",
    "            continue\n",
    "\n",
    "        try:\n",
    "            cgw_snr = float(record.get(\"cgw_snr\", np.nan))\n",
    "        except (TypeError, ValueError):\n",
    "            continue\n",
    "\n",
    "        if np.isfinite(cgw_snr):\n",
    "            usable.append((cgw_snr, record))\n",
    "\n",
    "    if not usable:\n",
    "        return None\n",
    "\n",
    "    return max(usable, key=lambda item: item[0])[1]\n",
    "\n",
    "\n",
    "def normalized_pulsar_fractions(record):\n",
    "    \"\"\"\n",
    "    Convert one source's per-pulsar rho^2 values into fractions summing to one.\n",
    "    \"\"\"\n",
    "    raw = record.get(\"per_pulsar_rho_sq\", {}) or {}\n",
    "\n",
    "    rho_sq = {}\n",
    "\n",
    "    for pulsar, value in raw.items():\n",
    "        try:\n",
    "            value = float(value)\n",
    "        except (TypeError, ValueError):\n",
    "            continue\n",
    "\n",
    "        if np.isfinite(value) and value > 0.0:\n",
    "            rho_sq[str(pulsar)] = value\n",
    "\n",
    "    total = float(sum(rho_sq.values()))\n",
    "\n",
    "    if not np.isfinite(total) or total <= 0.0:\n",
    "        return {}\n",
    "\n",
    "    return {\n",
    "        pulsar: value / total\n",
    "        for pulsar, value in rho_sq.items()\n",
    "    }\n",
    "\n",
    "\n",
    "def build_configuration_weights(simulation_dirs, configuration):\n",
    "    \"\"\"\n",
    "    Calculate median normalized per-pulsar rho^2 contributions for one\n",
    "    population configuration.\n",
    "\n",
    "    Missing pulsars in a particular simulation are assigned zero for that\n",
    "    simulation before taking the median.\n",
    "    \"\"\"\n",
    "    per_simulation = []\n",
    "    simulations_used = []\n",
    "\n",
    "    for sim_dir in simulation_dirs:\n",
    "        sim_configuration = infer_population_configuration(sim_dir)\n",
    "\n",
    "        if sim_configuration != configuration:\n",
    "            continue\n",
    "\n",
    "        records = load_top_breakdowns(sim_dir)\n",
    "        loudest = select_loudest_breakdown(records)\n",
    "\n",
    "        if loudest is None:\n",
    "            continue\n",
    "\n",
    "        fractions = normalized_pulsar_fractions(loudest)\n",
    "\n",
    "        if not fractions:\n",
    "            continue\n",
    "\n",
    "        per_simulation.append(fractions)\n",
    "        simulations_used.append(str(Path(sim_dir)))\n",
    "\n",
    "    if not per_simulation:\n",
    "        raise RuntimeError(\n",
    "            f\"No usable CGW breakdowns found for \"\n",
    "            f\"configuration {configuration!r}\"\n",
    "        )\n",
    "\n",
    "    all_pulsars = sorted({\n",
    "        pulsar\n",
    "        for fractions in per_simulation\n",
    "        for pulsar in fractions\n",
    "    })\n",
    "\n",
    "    fraction_matrix = np.asarray([\n",
    "        [\n",
    "            fractions.get(pulsar, 0.0)\n",
    "            for pulsar in all_pulsars\n",
    "        ]\n",
    "        for fractions in per_simulation\n",
    "    ], dtype=float)\n",
    "\n",
    "    median_fraction = np.median(fraction_matrix, axis=0)\n",
    "\n",
    "    # Re-normalize after the per-pulsar medians. The sum of medians need not\n",
    "    # be exactly one because the median is taken independently per pulsar.\n",
    "    total = float(np.sum(median_fraction))\n",
    "\n",
    "    if not np.isfinite(total) or total <= 0.0:\n",
    "        raise RuntimeError(\n",
    "            f\"Median contribution weights for {configuration!r} \"\n",
    "            \"have a non-positive or non-finite sum\"\n",
    "        )\n",
    "\n",
    "    weights = {\n",
    "        pulsar: float(value / total)\n",
    "        for pulsar, value in zip(all_pulsars, median_fraction)\n",
    "        if value > 0.0\n",
    "    }\n",
    "\n",
    "    return weights, {\n",
    "        \"configuration\": configuration,\n",
    "        \"n_simulations_used\": len(per_simulation),\n",
    "        \"simulation_directories\": simulations_used,\n",
    "        \"source_selection\": \"loudest_saved_cgw_source\",\n",
    "        \"source_metric\": \"rho_sq_fraction\",\n",
    "        \"weight_sum\": float(sum(weights.values())),\n",
    "    }\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Build and save one JSON file per population configuration\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "simulation_dirs = find_simulation_directories(RUNS_ROOT)\n",
    "\n",
    "print(f\"Found {len(simulation_dirs)} completed simulations\")\n",
    "\n",
    "for configuration in CONFIGURATIONS:\n",
    "    try:\n",
    "        weights, diagnostics = build_configuration_weights(\n",
    "            simulation_dirs=simulation_dirs,\n",
    "            configuration=configuration,\n",
    "        )\n",
    "    except RuntimeError as exc:\n",
    "        print(f\"[{configuration}] skipped: {exc}\")\n",
    "        continue\n",
    "\n",
    "    payload = {\n",
    "        \"schema_version\": 1,\n",
    "        \"configuration\": configuration,\n",
    "        \"source_selection\": \"loudest_saved_cgw_source\",\n",
    "        \"source_metric\": \"rho_sq_fraction\",\n",
    "        \"weights\": weights,\n",
    "        \"weight_sum\": float(sum(weights.values())),\n",
    "        \"diagnostics\": diagnostics,\n",
    "    }\n",
    "\n",
    "    output_path = OUTPUT_DIR / f\"{configuration}.json\"\n",
    "\n",
    "    with output_path.open(\"w\") as fh:\n",
    "        json.dump(payload, fh, indent=2, sort_keys=True)\n",
    "\n",
    "    print(\n",
    "        f\"[{configuration}] wrote {output_path} \"\n",
    "        f\"({len(weights)} pulsars, \"\n",
    "        f\"{diagnostics['n_simulations_used']} simulations, \"\n",
    "        f\"weight sum={payload['weight_sum']:.12f})\"\n",
    "    )"
   ]
  },
