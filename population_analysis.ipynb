   ],
   "source": [
    "# ============================================================================\n",
    "# Separate baseline-only and full-synthetic-PTA simulations\n",
    "# ============================================================================\n",
    "#\n",
    "# Available modes:\n",
    "#\n",
    "#   \"all_pta\"\n",
    "#       Use only simulations containing the complete synthetic PTA set.\n",
    "#       This is the default for normal analysis and source-fraction tables.\n",
    "#\n",
    "#   \"nanograv_candidates\"\n",
    "#       Use both baseline-only simulations and full synthetic-PTA simulations.\n",
    "#       Use this for comparisons with the NANOGrav candidate population.\n",
    "#\n",
    "#   \"baseline_only\"\n",
    "#       Use only simulations with baseline/baseline_forecast results and no\n",
    "#       synthetic PTA outputs.\n",
    "#\n",
    "#   \"full_synthetic\"\n",
    "#       Use only simulations containing the complete synthetic PTA set.\n",
    "#\n",
    "# The original dataframes are preserved as *_all.\n",
    "# ============================================================================\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Select the analysis mode here\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "# ANALYSIS_MODE = \"all_pta\"\n",
    "\n",
    "# Change to this for the NANOGrav candidate comparison:\n",
    "ANALYSIS_MODE = \"nanograv_candidates\"\n",
    "\n",
    "VALID_ANALYSIS_MODES = {\n",
    "    \"all_pta\",\n",
    "    \"nanograv_candidates\",\n",
    "    \"baseline_only\",\n",
    "    \"full_synthetic\",\n",
    "}\n",
    "\n",
    "if ANALYSIS_MODE not in VALID_ANALYSIS_MODES:\n",
    "    raise ValueError(\n",
    "        f\"Unknown ANALYSIS_MODE={ANALYSIS_MODE!r}. \"\n",
    "        f\"Choose one of {sorted(VALID_ANALYSIS_MODES)}.\"\n",
    "    )\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Identify the synthetic PTA labels\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "if \"synthetic_pta_labels\" not in globals():\n",
    "    raise NameError(\n",
    "        \"synthetic_pta_labels is not defined. \"\n",
    "        \"Run the synthetic-PTA discovery cells first.\"\n",
    "    )\n",
    "\n",
    "# These are not treated as synthetic PTAs for the purpose of classifying\n",
    "# simulations. They are the standard comparison scenarios.\n",
    "baseline_labels = {\n",
    "    \"baseline\",\n",
    "    \"baseline_forecast\",\n",
    "}\n",
    "\n",
    "synthetic_only_labels = sorted(\n",
    "    set(synthetic_pta_labels) - baseline_labels\n",
    ")\n",
    "\n",
    "if not synthetic_only_labels:\n",
    "    raise ValueError(\n",
    "        \"No synthetic PTA labels were found after removing \"\n",
    "        \"'baseline' and 'baseline_forecast'.\"\n",
    "    )\n",
    "\n",
    "required_synthetic_fields = [\n",
    "    f\"cgw_snr_{label}\"\n",
    "    for label in synthetic_only_labels\n",
    "]\n",
    "\n",
    "print(\"Synthetic PTA labels used for classification:\")\n",
    "print(f\"  {synthetic_only_labels}\")\n",
    "\n",
    "print(\"\\nRequired synthetic PTA fields:\")\n",
    "print(f\"  {required_synthetic_fields}\")\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Normalise source-file paths\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "def _normalise_source_file(path):\n",
    "    if path is None or pd.isna(path):\n",
    "        return None\n",
    "\n",
    "    try:\n",
    "        return str(Path(str(path)).expanduser().resolve())\n",
    "    except Exception:\n",
    "        return str(path)\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Classify every result file\n",
    "# ---------------------------------------------------------------------------\n",
    "#\n",
    "# A file is \"full_synthetic\" only when every configured synthetic PTA field is\n",
    "# present in its arrays. This prevents partially generated simulations from\n",
    "# being silently included in the full-synthetic analysis.\n",
    "#\n",
    "# A file is \"baseline_only\" when none of the synthetic PTA fields are present.\n",
    "# Files with only some synthetic fields are labelled \"partial_synthetic\" and\n",
    "# excluded from the two main views.\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "if \"result_files\" not in globals():\n",
    "    raise NameError(\n",
    "        \"result_files is not defined. Run the result-file discovery cell first.\"\n",
    "    )\n",
    "\n",
    "file_family_rows = []\n",
    "\n",
    "for result_file in result_files:\n",
    "    source_path = _normalise_source_file(result_file)\n",
    "\n",
    "    present_fields = set()\n",
    "\n",
    "    try:\n",
    "        payload = _load_payload(result_file, verbose=False)\n",
    "\n",
    "        if isinstance(payload, dict):\n",
    "            arrays = payload.get(\"arrays\", {})\n",
    "            if isinstance(arrays, dict):\n",
    "                present_fields = {\n",
    "                    field\n",
    "                    for field in required_synthetic_fields\n",
    "                    if field in arrays\n",
    "                }\n",
    "\n",
    "    except Exception as exc:\n",
    "        print(\n",
    "            f\"WARNING: Could not inspect {result_file}: \"\n",
    "            f\"{type(exc).__name__}: {exc}\"\n",
    "        )\n",
    "\n",
    "    n_present = len(present_fields)\n",
    "\n",
    "    if n_present == 0:\n",
    "        family = \"baseline_only\"\n",
    "    elif n_present == len(required_synthetic_fields):\n",
    "        family = \"full_synthetic\"\n",
    "    else:\n",
    "        family = \"partial_synthetic\"\n",
    "\n",
    "    file_family_rows.append({\n",
    "        \"source_file\": source_path,\n",
    "        \"simulation_family\": family,\n",
    "        \"n_synthetic_fields_present\": n_present,\n",
    "        \"n_synthetic_fields_required\": len(required_synthetic_fields),\n",
    "    })\n",
    "\n",
    "file_family_df = pd.DataFrame(file_family_rows)\n",
    "\n",
    "if file_family_df.empty:\n",
    "    raise ValueError(\"No result files could be classified.\")\n",
    "\n",
    "file_family_map = dict(\n",
    "    zip(\n",
    "        file_family_df[\"source_file\"],\n",
    "        file_family_df[\"simulation_family\"],\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"\\nSimulation-file classification:\")\n",
    "print(\n",
    "    file_family_df[\"simulation_family\"]\n",
    "    .value_counts(dropna=False)\n",
    "    .rename_axis(\"simulation_family\")\n",
    "    .to_string()\n",
    ")\n",
    "\n",
    "partial_files = file_family_df.loc[\n",
    "    file_family_df[\"simulation_family\"] == \"partial_synthetic\"\n",
    "]\n",
    "\n",
    "if not partial_files.empty:\n",
    "    print(\n",
    "        \"\\nWARNING: Partial synthetic-PTA files were found. \"\n",
    "        \"They are excluded from the main analysis views:\"\n",
    "    )\n",
    "    display(partial_files.head(10))\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Helper for filtering any dataframe that contains source_file\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "def _filter_dataframe_by_family(df, families):\n",
    "    if df is None or not isinstance(df, pd.DataFrame):\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    if df.empty:\n",
    "        return df.copy()\n",
    "\n",
    "    if \"source_file\" not in df.columns:\n",
    "        raise KeyError(\n",
    "            \"Cannot classify this dataframe because it has no 'source_file' \"\n",
    "            \"column. Available columns are:\\n\"\n",
    "            f\"{list(df.columns)}\"\n",
    "        )\n",
    "\n",
    "    out = df.copy()\n",
    "    out[\"_normalised_source_file\"] = out[\"source_file\"].map(\n",
    "        _normalise_source_file\n",
    "    )\n",
    "    out[\"_simulation_family\"] = out[\"_normalised_source_file\"].map(\n",
    "        file_family_map\n",
    "    )\n",
    "\n",
    "    out = out.loc[\n",
    "        out[\"_simulation_family\"].isin(set(families))\n",
    "    ].copy()\n",
    "\n",
    "    out.drop(columns=[\"_normalised_source_file\"], inplace=True)\n",
    "\n",
    "    return out\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Preserve complete original tables\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "if \"binary_df\" in globals():\n",
    "    binary_df_all = binary_df.copy()\n",
    "\n",
    "if \"cgw_sim_df\" in globals():\n",
    "    cgw_sim_df_all = cgw_sim_df.copy()\n",
    "\n",
    "if \"synpta_sim_df\" in globals():\n",
    "    synpta_sim_df_all = synpta_sim_df.copy()\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Construct the analysis views\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "if ANALYSIS_MODE == \"all_pta\":\n",
    "    selected_families = {\"full_synthetic\"}\n",
    "\n",
    "elif ANALYSIS_MODE == \"full_synthetic\":\n",
    "    selected_families = {\"full_synthetic\"}\n",
    "\n",
    "elif ANALYSIS_MODE == \"baseline_only\":\n",
    "    selected_families = {\"baseline_only\"}\n",
    "\n",
    "elif ANALYSIS_MODE == \"nanograv_candidates\":\n",
    "    selected_families = {\n",
    "        \"baseline_only\",\n",
    "        \"full_synthetic\",\n",
    "    }\n",
    "\n",
    "# These are the dataframes to use in subsequent analysis cells.\n",
    "if \"binary_df_all\" in globals():\n",
    "    analysis_binary_df = _filter_dataframe_by_family(\n",
    "        binary_df_all,\n",
    "        selected_families,\n",
    "    )\n",
    "\n",
    "if \"cgw_sim_df_all\" in globals():\n",
    "    analysis_cgw_sim_df = _filter_dataframe_by_family(\n",
    "        cgw_sim_df_all,\n",
    "        selected_families,\n",
    "    )\n",
    "\n",
    "if \"synpta_sim_df_all\" in globals():\n",
    "    analysis_synpta_sim_df = _filter_dataframe_by_family(\n",
    "        synpta_sim_df_all,\n",
    "        selected_families,\n",
    "    )\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Optional aliases\n",
    "# ---------------------------------------------------------------------------\n",
    "#\n",
    "# Setting USE_ANALYSIS_VIEWS_AS_DEFAULT=True makes later cells that refer to\n",
    "# binary_df/cgw_sim_df/synpta_sim_df use the selected view.\n",
    "#\n",
    "# The originals remain available as binary_df_all, cgw_sim_df_all, and\n",
    "# synpta_sim_df_all.\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "USE_ANALYSIS_VIEWS_AS_DEFAULT = True\n",
    "\n",
    "if USE_ANALYSIS_VIEWS_AS_DEFAULT:\n",
    "    if \"analysis_binary_df\" in globals():\n",
    "        binary_df = analysis_binary_df.copy()\n",
    "\n",
    "    if \"analysis_cgw_sim_df\" in globals():\n",
    "        cgw_sim_df = analysis_cgw_sim_df.copy()\n",
    "\n",
    "    if \"analysis_synpta_sim_df\" in globals():\n",
    "        synpta_sim_df = analysis_synpta_sim_df.copy()\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Report the selected data\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "print(\"\\nSelected analysis mode:\")\n",
    "print(f\"  {ANALYSIS_MODE}\")\n",
    "\n",
    "print(\"\\nIncluded simulation families:\")\n",
    "for family in sorted(selected_families):\n",
    "    print(f\"  - {family}\")\n",
    "\n",
    "if \"analysis_binary_df\" in globals():\n",
    "    print(\n",
    "        f\"\\nanalysis_binary_df: \"\n",
    "        f\"{len(analysis_binary_df):,} binary rows\"\n",
    "    )\n",
    "\n",
    "if \"analysis_cgw_sim_df\" in globals():\n",
    "    print(\n",
    "        f\"analysis_cgw_sim_df: \"\n",
    "        f\"{len(analysis_cgw_sim_df):,} rows\"\n",
    "    )\n",
    "\n",
    "if \"analysis_synpta_sim_df\" in globals():\n",
    "    print(\n",
    "        f\"analysis_synpta_sim_df: \"\n",
    "        f\"{len(analysis_synpta_sim_df):,} rows\"\n",
    "    )\n",
    "\n",
    "# Show the number of unique source files in each selected table.\n",
    "for table_name in [\n",
    "    \"analysis_binary_df\",\n",
    "    \"analysis_cgw_sim_df\",\n",
    "    \"analysis_synpta_sim_df\",\n",
    "]:\n",
    "    table = globals().get(table_name)\n",
    "\n",
    "    if isinstance(table, pd.DataFrame) and not table.empty:\n",
    "        if \"source_file\" in table.columns:\n",
    "            n_files = table[\"source_file\"].map(\n",
    "                _normalise_source_file\n",
    "            ).nunique()\n",
    "            print(f\"  {table_name}: {n_files:,} source files\")"
   ]
