    "# ============================================================\n",
    "# SYNTHETIC PTA — frequency, one 1x3 figure per observing strategy.\n",
    "# Strategies: 4x cadence, 2x precision, combined (no TT-conserved).\n",
    "# ApJ two-column width (7.1 in), minimal whitespace, identical axes\n",
    "# geometry for all three figures so they stack cleanly.\n",
    "#   scenario-coloured filled histogram = fiducial,\n",
    "#   scenario-coloured outline          = synthetic PTA.\n",
    "# One legend in total (2x precision figure, top right, 2 columns).\n",
    "# ============================================================\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.lines as mlines\n",
    "import matplotlib.patches as mpatches\n",
    "from pathlib import Path\n",
    "\n",
    "FREQ_KEY        = 'f'\n",
    "FIDUCIAL_COLOR  = 'grey'\n",
    "FIDUCIAL_ALPHA  = 0.35\n",
    "SHARE_Y         = False\n",
    "N_BINS          = 20\n",
    "Tspan           = 9 * 365.25 * 24 * 3600  # 9 years in seconds\n",
    "\n",
    "# ── layout, all in inches ─────────────────────────────────────────────\n",
    "FIG_WIDTH       = 7.1     # ApJ two-column width\n",
    "AXES_HEIGHT     = 1.29    # identical in every figure\n",
    "M_LEFT          = 0.52\n",
    "M_RIGHT         = 0.06\n",
    "M_BOTTOM        = 0.40\n",
    "M_TOP           = 0.26    # title row for figures without a legend\n",
    "M_TOP_LEGEND    = 0.42    # taller title row for the figure with the 2-row legend\n",
    "W_SPACE         = 0.28\n",
    "\n",
    "KEEP_LABELS   = ['2x_precision', '4x_cadence', '4x_cad_2x_prec']\n",
    "LEGEND_LABEL  = '4x_cadence'   # only this figure gets the legend\n",
    "\n",
    "PANEL_ORDER = ['pessimistic', 'realistic', 'optimistic']   # left -> right\n",
    "\n",
    "SCENARIO_NAMES = {\n",
    "    'pessimistic': 'Light',\n",
    "    'realistic':   'Intermediate',\n",
    "    'optimistic':  'Heavy',\n",
    "}\n",
    "\n",
    "PTA_DISPLAY = {\n",
    "    '2x_precision':   r'$2 \\times$ Precision',\n",
    "    '4x_cadence':     r'$4 \\times$ Cadence',\n",
    "    '4x_cad_2x_prec': r'Combined',\n",
    "}\n",
    "\n",
    "_spec = [s for s in PARAM_SPECS if s[0] == FREQ_KEY]\n",
    "if not _spec:\n",
    "    raise KeyError(f\"'{FREQ_KEY}' not found in PARAM_SPECS\")\n",
    "_, f_xlabel, f_use_log = _spec[0]\n",
    "base_cgw_col = _BASELINE_COL_MAP.get(FREQ_KEY)\n",
    "\n",
    "if synpta_sim_df.empty or not synthetic_pta_labels:\n",
    "    print('No synthetic PTA data — skipping frequency panels.')\n",
    "else:\n",
    "    panels = [p for p in PANEL_ORDER if p in synpta_sim_df['scenario'].unique()]\n",
    "\n",
    "    for label, field in zip(synthetic_pta_labels, synthetic_snr_fields):\n",
    "        if label not in KEEP_LABELS:\n",
    "            continue\n",
    "\n",
    "        syn_detected = synpta_sim_df[synpta_sim_df[f'loudest_{field}'] >= CGW_SNR_THRESHOLD]\n",
    "        col = f'{field}_{FREQ_KEY}'\n",
    "        if col not in syn_detected.columns:\n",
    "            continue\n",
    "\n",
    "        # ── gather values per scenario ────────────────────────────────\n",
    "        syn_vals, base_vals = {}, {}\n",
    "        for pop in panels:\n",
    "            v = syn_detected.loc[syn_detected['scenario'] == pop, col].to_numpy(float)\n",
    "            v = v[np.isfinite(v)]\n",
    "            if v.size:\n",
    "                syn_vals[pop] = v\n",
    "\n",
    "            if base_cgw_col and not cgw_sim_df.empty:\n",
    "                bsub = cgw_sim_df[(cgw_sim_df['scenario'] == pop) &\n",
    "                                  (cgw_sim_df['loudest_cgw_snr'] >= CGW_SNR_THRESHOLD)]\n",
    "                bv = bsub[base_cgw_col].to_numpy(float)\n",
    "                bv = bv[np.isfinite(bv)]\n",
    "                if bv.size:\n",
    "                    base_vals[pop] = bv\n",
    "\n",
    "        if not syn_vals:\n",
    "            continue\n",
    "\n",
    "        # ── shared bins across all panels ─────────────────────────────\n",
    "        all_vals = np.concatenate(list(syn_vals.values()) + list(base_vals.values()))\n",
    "        if f_use_log:\n",
    "            all_vals = all_vals[all_vals > 0]\n",
    "        if all_vals.size == 0:\n",
    "            continue\n",
    "\n",
    "        if f_use_log:\n",
    "            bins = np.logspace(np.log10(all_vals.min()), np.log10(all_vals.max()), N_BINS)\n",
    "        else:\n",
    "            bins = np.arange(1 / Tspan, all_vals.max() + 1 / Tspan, 1 / Tspan)\n",
    "\n",
    "        # ── per-figure geometry: axes size is fixed, only the top row grows ──\n",
    "        has_legend = (label == LEGEND_LABEL)\n",
    "        m_top      = M_TOP_LEGEND if has_legend else M_TOP\n",
    "        fig_height = AXES_HEIGHT + M_BOTTOM + m_top\n",
    "\n",
    "        n = len(panels)\n",
    "        fig, axes = plt.subplots(1, n, figsize=(FIG_WIDTH, fig_height),\n",
    "                                 sharex=True, sharey=SHARE_Y)\n",
    "        axes = np.atleast_1d(axes)\n",
    "\n",
    "        fig.subplots_adjust(left=M_LEFT / FIG_WIDTH,\n",
    "                            right=1 - M_RIGHT / FIG_WIDTH,\n",
    "                            bottom=M_BOTTOM / fig_height,\n",
    "                            top=1 - m_top / fig_height,\n",
    "                            wspace=W_SPACE)\n",
    "\n",
    "        for i, (ax, pop) in enumerate(zip(axes, panels)):\n",
    "            st = _SYNPTA_POP_STYLES.get(pop, {'color': '#888', 'linestyle': '-', 'linewidth': 1.5})\n",
    "            lw = st.get('linewidth', 1.5) #+ 0.5\n",
    "\n",
    "            if pop in base_vals:\n",
    "                ax.hist(base_vals[pop], bins=bins, histtype='stepfilled',\n",
    "                        color=st['color'], alpha=FIDUCIAL_ALPHA,\n",
    "                        density=False, zorder=1)\n",
    "\n",
    "            if pop in syn_vals:\n",
    "                ax.hist(syn_vals[pop], bins=bins, histtype='step',\n",
    "                        color=st['color'], linestyle='-', linewidth=lw,\n",
    "                        density=False, zorder=2)\n",
    "\n",
    "            if f_use_log:\n",
    "                ax.set_xscale('log')\n",
    "\n",
    "            xlim = XLIM_OVERRIDES.get((label, FREQ_KEY))\n",
    "            if xlim is not None:\n",
    "                ax.set_xlim(*xlim)\n",
    "\n",
    "            ax.set_xlabel(f_xlabel, labelpad=1)\n",
    "            if i == 0:\n",
    "                ax.set_ylabel('Number of simulations', labelpad=2)\n",
    "            ax.spines['top'].set_visible(True)\n",
    "            ax.spines['right'].set_visible(True)\n",
    "\n",
    "        # ── title: centred over the axes area, pinned to the top edge ──\n",
    "        x_center = (M_LEFT + (FIG_WIDTH - M_LEFT - M_RIGHT) / 2) / FIG_WIDTH\n",
    "        fig.text(x_center, 1 - 0.02 / fig_height,\n",
    "                 PTA_DISPLAY.get(label, label),\n",
    "                 fontweight='bold', ha='center', va='top')\n",
    "\n",
    "        # ── the only legend: 2 columns, top right ─────────────────────\n",
    "        if has_legend:\n",
    "            handles = []\n",
    "            for pop in panels:\n",
    "                st = _SYNPTA_POP_STYLES.get(pop, {'color': '#888', 'linewidth': 1.5})\n",
    "                name = SCENARIO_NAMES.get(\n",
    "                    pop, SCENARIO_MASS_MAP.get(pop, _SYNPTA_LABEL_MAP.get(pop, pop)))\n",
    "                handles.append(\n",
    "                    mlines.Line2D([], [], color=st['color'], linestyle='-',\n",
    "                                  linewidth=st.get('linewidth', 1.5) + 0.5, label=name))\n",
    "            handles.append(\n",
    "                mpatches.Patch(facecolor=FIDUCIAL_COLOR, alpha=FIDUCIAL_ALPHA + 0.25,\n",
    "                               label='Fiducial'))\n",
    "            fig.legend(handles=handles, loc='upper right',\n",
    "                       bbox_to_anchor=(1 - M_RIGHT / FIG_WIDTH, 1.0),\n",
    "                       ncol=2, frameon=False,\n",
    "                       handlelength=1.3, handletextpad=0.4, columnspacing=1.2,\n",
    "                       labelspacing=0.2, borderaxespad=0.0, borderpad=0.0,\n",
    "                       fontsize='small')\n",
    "\n",
    "        out_path = Path('figures') / f'synpta_{label}_{FREQ_KEY}_by_scenario.pdf'\n",
    "        fig.savefig(out_path, dpi=300)   # no bbox='tight': keeps geometry fixed\n",
    "        plt.show()\n",
    "        plt.close(fig)\n",
    "        print(f'  saved {out_path}')"
