    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "psr_ra, psr_dec = np.pi, 0.0\n",
    "\n",
    "# zoom in tightly: +/- 5 degrees around the pulsar, at its own declination\n",
    "delta_deg = np.linspace(-5, 5, 2000)\n",
    "delta_rad = np.radians(delta_deg)\n",
    "\n",
    "source_ras = psr_ra + delta_rad\n",
    "source_decs = np.full_like(source_ras, psr_dec)  # fixed at pulsar's dec\n",
    "psi = np.zeros_like(source_ras)\n",
    "\n",
    "Fp_arr, Fx_arr = _antenna_response_vec(\n",
    "    psr_ra, psr_dec,\n",
    "    source_ras, source_decs,   # correct order this time\n",
    "    psi\n",
    ")\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(11, 4))\n",
    "axes[0].plot(delta_deg, Fp_arr, color='crimson')\n",
    "axes[0].set_xlabel('offset from pulsar [deg]'); axes[0].set_ylabel('Fp')\n",
    "axes[0].set_yscale('symlog')  # linear near zero, log for the spike\n",
    "\n",
    "axes[1].plot(delta_deg, Fx_arr, color='steelblue')\n",
    "axes[1].set_xlabel('offset from pulsar [deg]'); axes[1].set_ylabel('Fx')\n",
    "axes[1].set_yscale('symlog')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"max |Fp| near pulsar:\", np.nanmax(np.abs(Fp_arr)))\n",
    "print(\"max |Fx| near pulsar:\", np.nanmax(np.abs(Fx_arr)))"
   ]
  },
