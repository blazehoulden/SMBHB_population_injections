   "source": [
    "\"\"\"\n",
    "Corner plot of loudest CGW event parameters, split into two h0 sub-populations.\n",
    "\n",
    "    Low-h0:   h0 < 3.5e-15\n",
    "    High-h0:  h0 >= 3.5e-15\n",
    "\n",
    "Parameters:\n",
    "\n",
    "    fGW, h0, SNR, DL, Mc, q, SGWB SNR, RA, Dec\n",
    "\n",
    "One corner plot per scenario (lower-triangular 9x9 grid):\n",
    "  - diagonal panels: overlaid 1D histograms\n",
    "  - off-diagonal panels: overlaid pairwise scatter\n",
    "  - fGW, h0, SNR, DL, Mc, SGWB SNR: log-log\n",
    "  - q: linear (derived from Mc and M_total)\n",
    "  - RA, Dec: linear, in radians\n",
    "  - RA ticks: 0, pi, 2pi\n",
    "  - Dec ticks: -pi/4, 0, pi/4\n",
    "\n",
    "Two h0 populations are plotted on the same figure:\n",
    "\n",
    "    h0 <  3.5 x 10^-15\n",
    "    h0 >= 3.5 x 10^-15\n",
    "\n",
    "Assumes these already exist in your notebook/session:\n",
    "    cgw_threshold_sim_df\n",
    "    scenario_order\n",
    "    scenario_styles\n",
    "    figure_dir\n",
    "    APJ_COL_WIDTH_DOUBLE\n",
    "\"\"\"\n",
    "\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib as mpl\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.ticker as mticker\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Basic checks\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "if cgw_threshold_sim_df.empty:\n",
    "    raise RuntimeError(\n",
    "        'No CGW simulation table available to plot '\n",
    "        '(all simulations below threshold).'\n",
    "    )\n",
    "\n",
    "figure_dir = Path('figures')\n",
    "figure_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Derive mass ratio q from Mc and M_total\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "def _q_from_mc_mtot(mc, mtot):\n",
    "    \"\"\"\n",
    "    Symmetric mass ratio eta = (Mc/Mtot)^(5/3), then invert\n",
    "    eta = q / (1+q)^2 for q = m2/m1 <= 1 (physical root).\n",
    "    \"\"\"\n",
    "    eta = (mc / mtot) ** (5.0 / 3.0)\n",
    "    eta = np.clip(eta, 1e-12, 0.25)   # guard against eta <= 0 or > 0.25\n",
    "    disc = 1.0 - 4.0 * eta\n",
    "    disc = np.clip(disc, 0, None)     # guard against tiny negative round-off\n",
    "    q = (1.0 - 2.0 * eta - np.sqrt(disc)) / (2.0 * eta)\n",
    "    return q\n",
    "\n",
    "if 'loudest_M_total' not in cgw_threshold_sim_df.columns:\n",
    "    raise KeyError(\n",
    "        \"cgw_threshold_sim_df has no 'loudest_M_total' column -- \"\n",
    "        \"needed to derive mass ratio.\"\n",
    "    )\n",
    "\n",
    "cgw_threshold_sim_df['loudest_q'] = _q_from_mc_mtot(\n",
    "    cgw_threshold_sim_df['loudest_Mc'],\n",
    "    cgw_threshold_sim_df['loudest_M_total'],\n",
    ")\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# h0 population split\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "H0_SPLIT = 3.5e-15\n",
    "\n",
    "POPULATION_DEFS = {\n",
    "\n",
    "    'low_h0': {\n",
    "        'label': r'$h_0 < 3.5 \\times 10^{-15}$',\n",
    "        'color': '#00D9FF',       # bright cyan\n",
    "    },\n",
    "\n",
    "    'high_h0': {\n",
    "        'label': r'$h_0 \\geq 3.5 \\times 10^{-15}$',\n",
    "        'color': '#FF4F81',       # bright pink\n",
    "    },\n",
    "}\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Parameter registry\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "PARAMS = {\n",
    "\n",
    "    'h0': (\n",
    "        'loudest_h0',\n",
    "        r'$h_0$',\n",
    "        'log',\n",
    "        None,\n",
    "    ),\n",
    "\n",
    "    'f': (\n",
    "        'loudest_f',\n",
    "        r'$f$ [Hz]',\n",
    "        'log',\n",
    "        None,\n",
    "    ),\n",
    "\n",
    "    'snr': (\n",
    "        'loudest_cgw_snr',\n",
    "        r'$(\\mathrm{S/N})_{\\mathrm{CW}}$',\n",
    "        'log',\n",
    "        None,\n",
    "    ),\n",
    "\n",
    "    'D': (\n",
    "        'loudest_DL',\n",
    "        r'$D_{\\mathrm{L}}$ [Mpc]',\n",
    "        'log',\n",
    "        None,\n",
    "    ),\n",
    "\n",
    "    'Mc': (\n",
    "        'loudest_Mc',\n",
    "        r'$\\mathcal{M}\\ [\\mathrm{M}_\\odot]$',\n",
    "        'log',\n",
    "        None,\n",
    "    ),\n",
    "\n",
    "    'q': (\n",
    "        'loudest_q',\n",
    "        r'$q$',\n",
    "        'linear',\n",
    "        (0, 1),\n",
    "    ),\n",
    "\n",
    "    'sgwb': (\n",
    "        'sgwb_snr',\n",
    "        r'$(\\mathrm{S/N})_{\\mathrm{SGWB}}$',\n",
    "        'log',\n",
    "        None,\n",
    "    ),\n",
    "\n",
    "    'ra': (\n",
    "        'loudest_ra',\n",
    "        r'$\\mathrm{RA}$ [rad]',\n",
    "        'linear',\n",
    "        (0, 2 * np.pi),\n",
    "    ),\n",
    "\n",
    "    'dec': (\n",
    "        'loudest_dec',\n",
    "        r'$\\mathrm{Dec}$ [rad]',\n",
    "        'linear',\n",
    "        (-np.pi / 2, np.pi / 2),\n",
    "    ),\n",
    "}\n",
    "\n",
    "\n",
    "PARAM_KEYS = [\n",
    "    'h0',\n",
    "    'f',\n",
    "    'snr',\n",
    "    'D',\n",
    "    'Mc',\n",
    "    'q',\n",
    "    'sgwb',\n",
    "    'ra',\n",
    "    'dec',\n",
    "]\n",
    "\n",
    "N = len(PARAM_KEYS)\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Check required columns\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "missing_cols = [\n",
    "    PARAMS[k][0]\n",
    "    for k in PARAM_KEYS\n",
    "    if PARAMS[k][0] not in cgw_threshold_sim_df.columns\n",
    "]\n",
    "\n",
    "if missing_cols:\n",
    "    raise KeyError(\n",
    "        f\"cgw_threshold_sim_df is missing columns {missing_cols}. \"\n",
    "        \"Check the RA/Dec column names in PARAMS.\"\n",
    "    )\n",
    "\n",
    "if 'sgwb_snr' not in cgw_threshold_sim_df.columns:\n",
    "    raise KeyError(\n",
    "        \"cgw_threshold_sim_df has no 'sgwb_snr' column -- run the \"\n",
    "        \"SGWB-merge cell first.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Tick helpers\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "def _cap_log_ticks(ax, axis='both', numticks=3):\n",
    "\n",
    "    \"\"\"\n",
    "    Limit major ticks on log axes and suppress minor tick labels.\n",
    "    \"\"\"\n",
    "\n",
    "    if axis in ('x', 'both'):\n",
    "\n",
    "        ax.xaxis.set_major_locator(\n",
    "            mticker.LogLocator(\n",
    "                base=10.0,\n",
    "                numticks=numticks,\n",
    "            )\n",
    "        )\n",
    "\n",
    "        ax.xaxis.set_minor_locator(\n",
    "            mticker.LogLocator(\n",
    "                base=10.0,\n",
    "                subs='auto',\n",
    "                numticks=numticks,\n",
    "            )\n",
    "        )\n",
    "\n",
    "        ax.xaxis.set_minor_formatter(\n",
    "            mticker.NullFormatter()\n",
    "        )\n",
    "\n",
    "\n",
    "    if axis in ('y', 'both'):\n",
    "\n",
    "        ax.yaxis.set_major_locator(\n",
    "            mticker.LogLocator(\n",
    "                base=10.0,\n",
    "                numticks=numticks,\n",
    "            )\n",
    "        )\n",
    "\n",
    "        ax.yaxis.set_minor_locator(\n",
    "            mticker.LogLocator(\n",
    "                base=10.0,\n",
    "                subs='auto',\n",
    "                numticks=numticks,\n",
    "            )\n",
    "        )\n",
    "\n",
    "        ax.yaxis.set_minor_formatter(\n",
    "            mticker.NullFormatter()\n",
    "        )\n",
    "\n",
    "\n",
    "def _cap_linear_ticks(ax, axis='both', nbins=3):\n",
    "\n",
    "    \"\"\"\n",
    "    Keep linear axes from becoming overloaded.\n",
    "    \"\"\"\n",
    "\n",
    "    if axis in ('x', 'both'):\n",
    "\n",
    "        ax.xaxis.set_major_locator(\n",
    "            mticker.MaxNLocator(\n",
    "                nbins=nbins,\n",
    "                prune='both',\n",
    "            )\n",
    "        )\n",
    "\n",
    "    if axis in ('y', 'both'):\n",
    "\n",
    "        ax.yaxis.set_major_locator(\n",
    "            mticker.MaxNLocator(\n",
    "                nbins=nbins,\n",
    "                prune='both',\n",
    "            )\n",
    "        )\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Explicit angular tick formatter\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "def _set_angular_ticks(ax, axis, parameter):\n",
    "\n",
    "    \"\"\"\n",
    "    Explicit pi-based ticks.\n",
    "\n",
    "    RA:\n",
    "        0, pi, 2pi\n",
    "\n",
    "    Dec:\n",
    "        -pi/4, 0, pi/4\n",
    "    \"\"\"\n",
    "\n",
    "    if parameter == 'ra':\n",
    "\n",
    "        ticks = [\n",
    "            0,\n",
    "            np.pi,\n",
    "            2 * np.pi,\n",
    "        ]\n",
    "\n",
    "        labels = [\n",
    "            r'$0$',\n",
    "            r'$\\pi$',\n",
    "            r'$2\\pi$',\n",
    "        ]\n",
    "\n",
    "    elif parameter == 'dec':\n",
    "\n",
    "        ticks = [\n",
    "            -np.pi / 4,\n",
    "            0,\n",
    "            np.pi / 4,\n",
    "        ]\n",
    "\n",
    "        labels = [\n",
    "            r'$-\\pi/4$',\n",
    "            r'$0$',\n",
    "            r'$\\pi/4$',\n",
    "        ]\n",
    "\n",
    "    else:\n",
    "\n",
    "        return\n",
    "\n",
    "\n",
    "    if axis == 'x':\n",
    "\n",
    "        ax.set_xticks(ticks)\n",
    "\n",
    "        ax.set_xticklabels(\n",
    "            labels,\n",
    "            fontsize=5.5,\n",
    "        )\n",
    "\n",
    "    elif axis == 'y':\n",
    "\n",
    "        ax.set_yticks(ticks)\n",
    "\n",
    "        ax.set_yticklabels(\n",
    "            labels,\n",
    "            fontsize=5.5,\n",
    "        )\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Plot function\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "def plot_corner_scenario(scenario, fname):\n",
    "\n",
    "    # ---------------------------------------------------------------------\n",
    "    # Select scenario\n",
    "    # ---------------------------------------------------------------------\n",
    "\n",
    "    sub = cgw_threshold_sim_df[\n",
    "        cgw_threshold_sim_df['scenario'] == scenario\n",
    "    ].copy()\n",
    "\n",
    "    if sub.empty:\n",
    "\n",
    "        print(\n",
    "            f'  skipped {fname} '\n",
    "            f'(no data for scenario={scenario})'\n",
    "        )\n",
    "\n",
    "        return\n",
    "\n",
    "\n",
    "    # ---------------------------------------------------------------------\n",
    "    # Split into populations\n",
    "    # ---------------------------------------------------------------------\n",
    "\n",
    "    low_h0 = sub[\n",
    "        sub['loudest_h0'] < H0_SPLIT\n",
    "    ].copy()\n",
    "\n",
    "    high_h0 = sub[\n",
    "        sub['loudest_h0'] >= H0_SPLIT\n",
    "    ].copy()\n",
    "\n",
    "\n",
    "    populations = {\n",
    "        'low_h0': low_h0,\n",
    "        'high_h0': high_h0,\n",
    "    }\n",
    "\n",
    "\n",
    "    print(f'\\n{scenario}:')\n",
    "\n",
    "    print(\n",
    "        f'  Total   : {len(sub):6d}'\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f'  Low h0  : {len(low_h0):6d} '\n",
    "        f'({100 * len(low_h0) / len(sub):5.1f}%)'\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f'  High h0 : {len(high_h0):6d} '\n",
    "        f'({100 * len(high_h0) / len(sub):5.1f}%)'\n",
    "    )\n",
    "\n",
    "\n",
    "    # ---------------------------------------------------------------------\n",
    "    # Local style\n",
    "    # ---------------------------------------------------------------------\n",
    "\n",
    "    corner_rc = {\n",
    "\n",
    "        'font.size':       8.5,\n",
    "\n",
    "        'axes.labelsize':  9,\n",
    "\n",
    "        'xtick.labelsize': 6.5,\n",
    "\n",
    "        'ytick.labelsize': 6.5,\n",
    "\n",
    "        'legend.fontsize': 8,\n",
    "\n",
    "    }\n",
    "\n",
    "\n",
    "    fig_width = APJ_COL_WIDTH_DOUBLE\n",
    "    fig_height = APJ_COL_WIDTH_DOUBLE\n",
    "\n",
    "\n",
    "    with mpl.rc_context(corner_rc):\n",
    "\n",
    "        fig, axes = plt.subplots(\n",
    "            N,\n",
    "            N,\n",
    "            figsize=(fig_width, fig_height),\n",
    "        )\n",
    "\n",
    "\n",
    "        # ================================================================\n",
    "        # Loop over panels\n",
    "        # ================================================================\n",
    "\n",
    "        for i, ykey in enumerate(PARAM_KEYS):\n",
    "\n",
    "            for j, xkey in enumerate(PARAM_KEYS):\n",
    "\n",
    "                ax = axes[i, j]\n",
    "\n",
    "\n",
    "                # --------------------------------------------------------\n",
    "                # Upper triangle\n",
    "                # --------------------------------------------------------\n",
    "\n",
    "                if j > i:\n",
    "\n",
    "                    ax.axis('off')\n",
    "\n",
    "                    continue\n",
    "\n",
    "\n",
    "                xcol, xlabel, xscale, xlim = PARAMS[xkey]\n",
    "\n",
    "\n",
    "                # ========================================================\n",
    "                # DIAGONAL: HISTOGRAM\n",
    "                # ========================================================\n",
    "\n",
    "                if i == j:\n",
    "\n",
    "                    all_vals = []\n",
    "\n",
    "\n",
    "                    for pop_df in populations.values():\n",
    "\n",
    "                        vals = pop_df[xcol]\n",
    "\n",
    "                        if xscale == 'log':\n",
    "                            vals = vals[vals > 0]\n",
    "\n",
    "                        vals = vals.dropna()\n",
    "\n",
    "                        if len(vals) > 0:\n",
    "\n",
    "                            all_vals.append(\n",
    "                                vals.to_numpy()\n",
    "                            )\n",
    "\n",
    "\n",
    "                    if len(all_vals) == 0:\n",
    "\n",
    "                        ax.text(\n",
    "                            0.5,\n",
    "                            0.5,\n",
    "                            'no data',\n",
    "                            ha='center',\n",
    "                            va='center',\n",
    "                            transform=ax.transAxes,\n",
    "                            fontsize=8,\n",
    "                            color='0.5',\n",
    "                        )\n",
    "\n",
    "                        ax.set_xticks([])\n",
    "                        ax.set_yticks([])\n",
    "\n",
    "\n",
    "                    else:\n",
    "\n",
    "                        all_vals = np.concatenate(\n",
    "                            all_vals\n",
    "                        )\n",
    "\n",
    "\n",
    "                        # ------------------------------------------------\n",
    "                        # Common bins\n",
    "                        # ------------------------------------------------\n",
    "\n",
    "                        if xscale == 'log':\n",
    "\n",
    "                            xmin = np.min(all_vals)\n",
    "                            xmax = np.max(all_vals)\n",
    "\n",
    "                            if xmin == xmax:\n",
    "\n",
    "                                xmin *= 0.9\n",
    "                                xmax *= 1.1\n",
    "\n",
    "                            bins = np.logspace(\n",
    "                                np.log10(xmin),\n",
    "                                np.log10(xmax),\n",
    "                                20,\n",
    "                            )\n",
    "\n",
    "\n",
    "                        else:\n",
    "\n",
    "                            if xlim is not None:\n",
    "\n",
    "                                lo, hi = xlim\n",
    "\n",
    "                            else:\n",
    "\n",
    "                                lo = np.min(all_vals)\n",
    "                                hi = np.max(all_vals)\n",
    "\n",
    "                                if lo == hi:\n",
    "\n",
    "                                    lo -= 0.5\n",
    "                                    hi += 0.5\n",
    "\n",
    "                            bins = np.linspace(\n",
    "                                lo,\n",
    "                                hi,\n",
    "                                20,\n",
    "                            )\n",
    "\n",
    "\n",
    "                        # ------------------------------------------------\n",
    "                        # Plot both populations\n",
    "                        # ------------------------------------------------\n",
    "\n",
    "                        for pop_name, pop_df in populations.items():\n",
    "\n",
    "                            xvals = pop_df[xcol]\n",
    "\n",
    "                            if xscale == 'log':\n",
    "                                xvals = xvals[xvals > 0]\n",
    "\n",
    "                            xvals = xvals.dropna()\n",
    "\n",
    "\n",
    "                            if len(xvals) == 0:\n",
    "                                continue\n",
    "\n",
    "\n",
    "                            ax.hist(\n",
    "                                xvals,\n",
    "                                bins=bins,\n",
    "                                color=POPULATION_DEFS[\n",
    "                                    pop_name\n",
    "                                ]['color'],\n",
    "                                alpha=0.65,\n",
    "                                histtype='stepfilled',\n",
    "                                linewidth=0,\n",
    "                            )\n",
    "\n",
    "\n",
    "                        ax.set_xscale(xscale)\n",
    "\n",
    "\n",
    "                        if xlim is not None:\n",
    "                            ax.set_xlim(xlim)\n",
    "\n",
    "\n",
    "                        ax.set_yticks([])\n",
    "\n",
    "\n",
    "                        # ------------------------------------------------\n",
    "                        # X ticks\n",
    "                        # ------------------------------------------------\n",
    "\n",
    "                        if xkey in ('ra', 'dec'):\n",
    "\n",
    "                            _set_angular_ticks(\n",
    "                                ax,\n",
    "                                axis='x',\n",
    "                                parameter=xkey,\n",
    "                            )\n",
    "\n",
    "                        elif xscale == 'log':\n",
    "\n",
    "                            _cap_log_ticks(\n",
    "                                ax,\n",
    "                                axis='x',\n",
    "                                numticks=3,\n",
    "                            )\n",
    "\n",
    "                        else:\n",
    "\n",
    "                            _cap_linear_ticks(\n",
    "                                ax,\n",
    "                                axis='x',\n",
    "                                nbins=3,\n",
    "                            )\n",
    "\n",
    "\n",
    "                # ========================================================\n",
    "                # OFF-DIAGONAL: SCATTER\n",
    "                # ========================================================\n",
    "\n",
    "                else:\n",
    "\n",
    "                    ycol, ylabel, yscale, ylim = PARAMS[ykey]\n",
    "\n",
    "\n",
    "                    for pop_name, pop_df in populations.items():\n",
    "\n",
    "                        if xscale == 'log':\n",
    "\n",
    "                            xmask = (\n",
    "                                pop_df[xcol] > 0\n",
    "                            )\n",
    "\n",
    "                        else:\n",
    "\n",
    "                            xmask = (\n",
    "                                pop_df[xcol].notna()\n",
    "                            )\n",
    "\n",
    "\n",
    "                        if yscale == 'log':\n",
    "\n",
    "                            ymask = (\n",
    "                                pop_df[ycol] > 0\n",
    "                            )\n",
    "\n",
    "                        else:\n",
    "\n",
    "                            ymask = (\n",
    "                                pop_df[ycol].notna()\n",
    "                            )\n",
    "\n",
    "\n",
    "                        mask = xmask & ymask\n",
    "\n",
    "\n",
    "                        if mask.sum() == 0:\n",
    "                            continue\n",
    "\n",
    "\n",
    "                        ax.scatter(\n",
    "                            pop_df.loc[mask, xcol],\n",
    "                            pop_df.loc[mask, ycol],\n",
    "                            s=3,\n",
    "                            alpha=0.28,\n",
    "                            color=POPULATION_DEFS[\n",
    "                                pop_name\n",
    "                            ]['color'],\n",
    "                            rasterized=True,\n",
    "                        )\n",
    "\n",
    "\n",
    "                    ax.set_xscale(xscale)\n",
    "                    ax.set_yscale(yscale)\n",
    "\n",
    "\n",
    "                    if xlim is not None:\n",
    "                        ax.set_xlim(xlim)\n",
    "\n",
    "                    if ylim is not None:\n",
    "                        ax.set_ylim(ylim)\n",
    "\n",
    "\n",
    "                    # ----------------------------------------------------\n",
    "                    # X ticks\n",
    "                    # ----------------------------------------------------\n",
    "\n",
    "                    if xkey in ('ra', 'dec'):\n",
    "\n",
    "                        _set_angular_ticks(\n",
    "                            ax,\n",
    "                            axis='x',\n",
    "                            parameter=xkey,\n",
    "                        )\n",
    "\n",
    "                    elif xscale == 'log':\n",
    "\n",
    "                        _cap_log_ticks(\n",
    "                            ax,\n",
    "                            axis='x',\n",
    "                            numticks=3,\n",
    "                        )\n",
    "\n",
    "                    else:\n",
    "\n",
    "                        _cap_linear_ticks(\n",
    "                            ax,\n",
    "                            axis='x',\n",
    "                            nbins=3,\n",
    "                        )\n",
    "\n",
    "\n",
    "                    # ----------------------------------------------------\n",
    "                    # Y ticks\n",
    "                    # ----------------------------------------------------\n",
    "\n",
    "                    if ykey in ('ra', 'dec'):\n",
    "\n",
    "                        _set_angular_ticks(\n",
    "                            ax,\n",
    "                            axis='y',\n",
    "                            parameter=ykey,\n",
    "                        )\n",
    "\n",
    "                    elif yscale == 'log':\n",
    "\n",
    "                        _cap_log_ticks(\n",
    "                            ax,\n",
    "                            axis='y',\n",
    "                            numticks=3,\n",
    "                        )\n",
    "\n",
    "                    else:\n",
    "\n",
    "                        _cap_linear_ticks(\n",
    "                            ax,\n",
    "                            axis='y',\n",
    "                            nbins=3,\n",
    "                        )\n",
    "\n",
    "\n",
    "                # ========================================================\n",
    "                # Tick visibility\n",
    "                # ========================================================\n",
    "\n",
    "                ax.tick_params(\n",
    "                    axis='x',\n",
    "                    which='both',\n",
    "                    labelbottom=(i == N - 1),\n",
    "                    pad=1.5,\n",
    "                )\n",
    "\n",
    "\n",
    "                ax.tick_params(\n",
