   "source": [
    "import numpy as np\n",
    "import config\n",
    "\n",
    "from data_loader import load_pulsars, filter_pulsars_15yr\n",
    "from signal_injection import (\n",
    "    _get_psr_radec,\n",
    "    antenna_response,\n",
    ")\n",
    "\n",
    "source_ra = 0.34716796875\n",
    "source_dec = -0.40966796875\n",
    "source_psi = 2.541015625\n",
    "\n",
    "psrs = load_pulsars(verbose=False, scenario=\"baseline\")\n",
    "psrs, _, _ = filter_pulsars_15yr(psrs, verbose=False)\n",
    "\n",
    "psr = next(p for p in psrs if p.name == \"J0125-2327\")\n",
    "\n",
    "# Coordinate path used by the original calculation\n",
    "old_ra = float(psr._raj)\n",
    "old_dec = float(psr._decj)\n",
    "\n",
    "# Coordinate path used by the current helper\n",
    "new_ra, new_dec = _get_psr_radec(psr)\n",
    "new_ra = float(new_ra)\n",
    "new_dec = float(new_dec)\n",
    "\n",
    "print(\"J0125-2327 coordinates\")\n",
    "print(\"----------------------\")\n",
    "print(f\"old _raj       = {old_ra:.16g}\")\n",
    "print(f\"old _decj      = {old_dec:.16g}\")\n",
    "print(f\"new helper RA  = {new_ra:.16g}\")\n",
    "print(f\"new helper Dec = {new_dec:.16g}\")\n",
    "print()\n",
    "print(\"differences\")\n",
    "print(f\"dRA  [rad] = {new_ra - old_ra:.16g}\")\n",
    "print(f\"dDec [rad] = {new_dec - old_dec:.16g}\")\n",
    "print(f\"dRA  [deg] = {np.degrees(new_ra - old_ra):.12g}\")\n",
    "print(f\"dDec [deg] = {np.degrees(new_dec - old_dec):.12g}\")\n",
    "\n",
    "\n",
    "def source_pulsar_geometry(psr_ra, psr_dec):\n",
    "    # Same geometry as signal_injection._antenna_response_vec\n",
    "    omega_hat = np.array([\n",
    "        -np.cos(source_dec) * np.cos(source_ra),\n",
    "        -np.cos(source_dec) * np.sin(source_ra),\n",
    "        -np.sin(source_dec),\n",
    "    ])\n",
    "\n",
    "    p_hat = np.array([\n",
    "        np.cos(psr_dec) * np.cos(psr_ra),\n",
    "        np.cos(psr_dec) * np.sin(psr_ra),\n",
    "        np.sin(psr_dec),\n",
    "    ])\n",
    "\n",
    "    separation = np.arccos(np.clip(np.dot(\n",
    "        np.array([\n",
    "            np.cos(source_dec) * np.cos(source_ra),\n",
    "            np.cos(source_dec) * np.sin(source_ra),\n",
    "            np.sin(source_dec),\n",
    "        ]),\n",
    "        p_hat,\n",
    "    ), -1.0, 1.0))\n",
    "\n",
    "    denom = 1.0 + np.dot(p_hat, omega_hat)\n",
    "    fp, fx = antenna_response(\n",
    "        psr_ra, psr_dec,\n",
    "        source_ra, source_dec, source_psi,\n",
    "    )\n",
    "\n",
    "    return separation, denom, fp, fx\n",
    "\n",
    "\n",
    "for label, ra, dec in [\n",
    "    (\"old _raj/_decj\", old_ra, old_dec),\n",
    "    (\"new helper\", new_ra, new_dec),\n",
    "]:\n",
    "    separation, denom, fp, fx = source_pulsar_geometry(ra, dec)\n",
    "\n",
    "    print()\n",
    "    print(label)\n",
    "    print(\"-\" * len(label))\n",
    "    print(f\"source-pulsar separation = {np.degrees(separation):.12g} deg\")\n",
    "    print(f\"antenna denominator      = {denom:.16g}\")\n",
    "    print(f\"Fp                       = {fp:.16g}\")\n",
    "    print(f\"Fx                       = {fx:.16g}\")"
   ]
  },
