    "header += r' & \\shortstack{Top $(\\mathrm{S/N})_{\\mathrm{CW}}$ Source \\\\ Changed (\\%)} \\\\'\n",
    "lines.append(header)\n",
    "lines.append(r'\\midrule')\n",
    "\n",
    "visible_pops = [p for p in ('optimistic', 'realistic', 'pessimistic') if p in pop_scenarios]\n",
    "\n",
    "for si, pop in enumerate(visible_pops):\n",
    "\n",
    "    sub = det_df[det_df['scenario'] == pop].set_index('pta')\n",
    "    available_ptas = [pta for pta in pta_row_order if pta in sub.index]\n",
    "    n_rows = len(available_ptas)\n",
    "    if n_rows == 0:\n",
    "        continue\n",
    "\n",
    "    mass_label = scenario_mass_map[pop]\n",
    "\n",
    "    for ri, pta in enumerate(available_ptas):\n",
    "        frac_str = f'${fmt_pct_2sf(100.0 * float(sub.loc[pta, \"det_fraction\"]))}$'\n",
    "\n",
    "        if pta in ('baseline', 'baseline_forecast'):\n",
    "            chg_str = r'---'\n",
    "        else:\n",
    "            chg = pct_source_changed(pop, pta)\n",
    "            chg_str = r'---' if np.isnan(chg) else f'${fmt_pct_2sf(chg)}$'\n",
    "\n",
    "        mass_col = rf'\\multirow{{{n_rows}}}{{*}}{{{mass_label}}}' if ri == 0 else ''\n",
    "\n",
    "        row = f'{mass_col} & {pta_display.get(pta, pta)} & {frac_str}'\n",
    "        if include_counts:\n",
    "            n_det = int(sub.loc[pta, 'n_detected'])\n",
    "            n_tot = int(sub.loc[pta, 'n_total'])\n",
    "            row += f' & ${n_det}/{n_tot}$'\n",
    "        row += f' & {chg_str} \\\\\\\\'\n",
    "        lines.append(row)\n",
    "\n",
    "    if si < len(visible_pops) - 1:\n",
    "        lines.append(r'\\midrule')\n",
    "\n",
    "lines.append(r'\\bottomrule')\n",
