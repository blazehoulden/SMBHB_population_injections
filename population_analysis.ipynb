    "    '4x_cadence':                r'$4\\, \\times$ Cadence',\n",
    "    '4x_cadence_conserved':      r'$4\\, \\times$ Cadence$^\\dagger$',\n",
    "    '4x_cad_2x_prec':            r'Combined',\n",
    "    '4x_cad_2x_prec_conserved':  r'Combined$^\\dagger$',\n",
    "    'max_cadence_top10':         r'Max. Cadence -- Top 10$^\\dagger$',\n",
