    "import gzip\n",
    "import pickle\n",
    "import re\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------\n",
    "# Adjust these paths\n",
    "# ---------------------------------------------------------------------\n",
    "runs_root = Path(\"./runs\")\n",
    "sky_data = np.load(\"./data/mpta_pulsar_sky_locations.npz\")\n",
    "\n",
    "psr_names = sky_data[\"names\"]\n",
    "psr_ra = np.asarray(sky_data[\"ras\"], dtype=float)\n",
    "psr_dec = np.asarray(sky_data[\"decs\"], dtype=float)\n",
    "\n",
    "# Uncomment these only if the catalogue coordinates are in degrees\n",
    "# psr_ra = np.radians(psr_ra)\n",
    "# psr_dec = np.radians(psr_dec)\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------\n",
    "# Pulsar matching helpers\n",
    "# ---------------------------------------------------------------------\n",
    "def angular_separation(ra1, dec1, ra2, dec2):\n",
    "    delta_ra = ra1 - ra2\n",
    "    cos_sep = (\n",
    "        np.sin(dec1) * np.sin(dec2)\n",
    "        + np.cos(dec1) * np.cos(dec2) * np.cos(delta_ra)\n",
    "    )\n",
    "    return np.arccos(np.clip(cos_sep, -1.0, 1.0))\n",
    "\n",
    "\n",
    "def nearest_pulsar(ra, dec):\n",
    "    separations = angular_separation(ra, dec, psr_ra, psr_dec)\n",
    "    index = np.argmin(separations)\n",
    "    return psr_names[index], float(separations[index])\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------\n",
    "# Find the loudest source in one summary file\n",
    "# ---------------------------------------------------------------------\n",
    "def loudest_source_from_summary(summary_path):\n",
    "    with gzip.open(summary_path, \"rb\") as stream:\n",
    "        summary = pickle.load(stream)\n",
    "\n",
    "    arrays = summary[\"arrays\"]\n",
    "    meta = summary.get(\"meta\", {})\n",
    "\n",
    "    # Prefer the normal baseline cgw_snr field\n",
    "    snr_fields = [\n",
    "        field\n",
    "        for field in meta.get(\"snr_fields\", [])\n",
    "        if field in arrays and field.startswith(\"cgw_snr_baseline_forecast\")\n",
    "    ]\n",
    "\n",
    "    if \"cgw_snr_baseline_forecast\" in arrays:\n",
    "        snr_field = \"cgw_snr_baseline_forecast\"\n",
    "    elif snr_fields:\n",
    "        snr_field = snr_fields[0]\n",
    "    else:\n",
    "        raise KeyError(f\"No cgw_snr field found in {summary_path}\")\n",
    "\n",
    "    snrs = np.asarray(arrays[snr_field], dtype=float)\n",
    "    valid = np.isfinite(snrs)\n",
    "\n",
    "    if not np.any(valid):\n",
    "        raise ValueError(f\"No finite CW S/N values in {summary_path}\")\n",
    "\n",
    "    valid_indices = np.flatnonzero(valid)\n",
    "    source_index = int(valid_indices[np.argmax(snrs[valid])])\n",
    "\n",
    "    # Save every scalar per-binary field at this source index\n",
    "    source = {}\n",
    "    for field, values in arrays.items():\n",
    "        values = np.asarray(values)\n",
    "\n",
    "        if values.ndim == 1 and len(values) > source_index:\n",
    "            value = values[source_index]\n",
    "\n",
    "            # Decode byte strings if present\n",
    "            if isinstance(value, bytes):\n",
    "                value = value.decode()\n",
    "\n",
    "            # Convert NumPy scalar values to normal Python values\n",
    "            if isinstance(value, np.generic):\n",
    "                value = value.item()\n",
    "\n",
    "            source[field] = value\n",
    "\n",
    "    sim_dir = summary_path.parent\n",
    "\n",
    "    # Extract sim number from names such as sim000, sim001, etc.\n",
    "    match = re.search(r\"sim(\\d+)$\", sim_dir.name)\n",
    "    sim_number = int(match.group(1)) if match else None\n",
    "\n",
    "    source.update({\n",
    "        \"summary_path\": str(summary_path),\n",
    "        \"simulation_directory\": str(sim_dir),\n",
    "        \"sim_number\": sim_number,\n",
    "        \"source_index\": source_index,\n",
    "        \"snr_field_used\": snr_field,\n",
    "        \"loudest_cgw_snr\": float(snrs[source_index]),\n",
    "        \"mode\": sim_dir.parent.name,\n",
    "    })\n",
    "\n",
    "    return source\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------\n",
    "# Build one row per simulation\n",
    "# ---------------------------------------------------------------------\n",
    "summary_paths = sorted(runs_root.rglob(\"summary.pkl.gz\"))\n",
    "\n",
    "if not summary_paths:\n",
    "    raise FileNotFoundError(\n",
    "        f\"No summary.pkl.gz files found below {runs_root.resolve()}\"\n",
    "    )\n",
    "\n",
    "rows = []\n",
    "errors = []\n",
    "\n",
    "for summary_path in summary_paths:\n",
    "    try:\n",
    "        rows.append(loudest_source_from_summary(summary_path))\n",
    "    except Exception as error:\n",
    "        errors.append((str(summary_path), repr(error)))\n",
    "\n",
    "if not rows:\n",
    "    raise RuntimeError(\"No usable summary.pkl.gz files were found\")\n",
    "\n",
    "df = pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------\n",
    "# Match each simulation's loudest source to its nearest pulsar\n",
    "# ---------------------------------------------------------------------\n",
    "if \"ra\" not in df.columns or \"dec\" not in df.columns:\n",
    "    raise KeyError(\n",
    "        \"The summaries do not contain both 'ra' and 'dec' fields. \"\n",
    "        f\"Available fields are: {list(df.columns)}\"\n",
    "    )\n",
    "\n",
    "nearest_results = df.apply(\n",
    "    lambda row: nearest_pulsar(float(row[\"ra\"]), float(row[\"dec\"])),\n",
    "    axis=1,\n",
    ")\n",
    "\n",
    "df[\"nearest_psr_name\"] = [result[0] for result in nearest_results]\n",
    "df[\"nearest_psr_sep_rad\"] = [result[1] for result in nearest_results]\n",
    "df[\"nearest_psr_sep_deg\"] = np.degrees(df[\"nearest_psr_sep_rad\"])\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------------------\n",
    "# Select and display only the globally loudest binary\n",
    "# ---------------------------------------------------------------------\n",
    "loudest = df.loc[df[\"loudest_cgw_snr\"].idxmax()]\n",
    "second_loudest = df.loc[df[\"loudest_cgw_snr\"].nlargest(2).index[-1]]\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"GLOBALLY LOUDEST CW BINARY\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"Simulation directory : {loudest['simulation_directory']}\")\n",
    "print(f\"Simulation number    : sim{int(loudest['sim_number']):03d}\")\n",
    "print(f\"Summary file         : {loudest['summary_path']}\")\n",
    "print(f\"Source index         : {int(loudest['source_index'])}\")\n",
    "print(f\"CW S/N               : {loudest['loudest_cgw_snr']:.8g}\")\n",
    "print(f\"Nearest pulsar       : {loudest['nearest_psr_name']}\")\n",
    "print(f\"Separation           : {loudest['nearest_psr_sep_deg']:.6f} deg\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"\\nAll saved parameters for this binary:\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "metadata_fields = {\n",
    "    \"summary_path\",\n",
    "    \"simulation_directory\",\n",
    "    \"sim_number\",\n",
    "    \"source_index\",\n",
    "    \"snr_field_used\",\n",
    "    \"loudest_cgw_snr\",\n",
    "    \"mode\",\n",
    "    \"nearest_psr_name\",\n",
    "    \"nearest_psr_sep_rad\",\n",
    "    \"nearest_psr_sep_deg\",\n",
    "}\n",
    "\n",
    "for field in loudest.index:\n",
    "    if field not in metadata_fields:\n",
    "        print(f\"{field:20s} = {loudest[field]}\")\n",
    "\n",
    "print(\"\\nUnit reminders:\")\n",
    "print(\"  f       : Hz\")\n",
    "print(\"  Mc/Mtot : solar masses\")\n",
    "print(\"  D_comov : Mpc\")\n",
    "print(\"  h0      : dimensionless strain\")\n",
    "print(\"  ra/dec  : radians\")\n",
    "print(\"  psi     : radians\")\n",
    "print(\"  iota    : radians\")\n",
    "print(\"  phi0    : radians\")\n",
    "print(\"  ecc     : dimensionless\")\n",
    "\n",
    "if errors:\n",
    "    print(f\"\\nSkipped {len(errors)} summary file(s):\")\n",
    "    for path, error in errors[:10]:\n",
    "        print(f\"  {path}: {error}\")\n",
    "\n",
    "# Second loudest\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"GLOBALLY LOUDEST CW BINARY\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"Simulation directory : {second_loudest['simulation_directory']}\")\n",
    "print(f\"Simulation number    : sim{int(second_loudest['sim_number']):03d}\")\n",
    "print(f\"Summary file         : {second_loudest['summary_path']}\")\n",
    "print(f\"Source index         : {int(second_loudest['source_index'])}\")\n",
    "print(f\"CW S/N               : {second_loudest['loudest_cgw_snr']:.8g}\")\n",
    "print(f\"Nearest pulsar       : {second_loudest['nearest_psr_name']}\")\n",
    "print(f\"Separation           : {second_loudest['nearest_psr_sep_deg']:.6f} deg\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"\\nAll saved parameters for this binary:\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "metadata_fields = {\n",
    "    \"summary_path\",\n",
    "    \"simulation_directory\",\n",
    "    \"sim_number\",\n",
    "    \"source_index\",\n",
    "    \"snr_field_used\",\n",
    "    \"loudest_cgw_snr\",\n",
    "    \"mode\",\n",
    "    \"nearest_psr_name\",\n",
    "    \"nearest_psr_sep_rad\",\n",
    "    \"nearest_psr_sep_deg\",\n",
    "}\n",
    "\n",
    "for field in second_loudest.index:\n",
    "    if field not in metadata_fields:\n",
    "        print(f\"{field:20s} = {second_loudest[field]}\")\n",
    "\n",
    "print(\"\\nUnit reminders:\")\n",
    "print(\"  f       : Hz\")\n",
    "print(\"  Mc/Mtot : solar masses\")\n",
    "print(\"  D_comov : Mpc\")\n",
    "print(\"  h0      : dimensionless strain\")\n",
    "print(\"  ra/dec  : radians\")\n",
    "print(\"  psi     : radians\")\n",
    "print(\"  iota    : radians\")\n",
    "print(\"  phi0    : radians\")\n",
    "print(\"  ecc     : dimensionless\")\n",
    "\n",
    "if errors:\n",
    "    print(f\"\\nSkipped {len(errors)} summary file(s):\")\n",
    "    for path, error in errors[:10]:\n",
    "        print(f\"  {path}: {error}\")"
   ]
