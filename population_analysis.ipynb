    "# ============================================================\n",
    "# SYNTHETIC PTA — STEP 3: how binary frequency changes relative\n",
    "# to the fiducial 9.0 yr strategy  (1:1 plots + summary bars)\n",
    "# ============================================================\n",
    "import matplotlib.lines as mlines\n",
    "\n",
    "REF_LABEL  = 'baseline_forecast'\n",
    "MATCH_KEYS = ['scenario', 'sim_id']      # same injected source in both PTAs\n",
    "TOL_NHZ    = 1e-3                        # |Δf| below this counts as \"unchanged\"\n",
    "_DEF_STYLE = {'color': '#888', 'linestyle': '-', 'linewidth': 1.5}\n",
