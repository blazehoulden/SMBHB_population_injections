    "ymin = min(arrays[n]['hc_det'].min() for n in names)\n",
    "ymax = max(arrays[n]['hc_det'].max() for n in names)\n",
    "ylim = (ymin * 0.5, ymax * 2)\n",
    "\n",
    "for k, current in enumerate(names):\n",
    "    to_plot = names[:k + 1] if cumulative else [current]\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(APJ_FIGSIZE[0] * 0.8, APJ_FIGSIZE[1] * 1.))\n",
    "    for n in to_plot:\n",
    "        d = arrays[n]\n",
    "        ax.loglog(d['freqs'], d['hc_det'], color=colors[n],\n",
    "                  lw=1.3 if n == names[0] else 1.0,\n",
    "                  label=get_label(n))\n",
    "\n",
    "    ax.set_xlabel('Frequency [Hz]')\n",
    "    # ax.set_ylabel('Characteristic\\nstrain $h_c$')\n",
    "    ax.set_xlim(1e-9, 3e-7)\n",
    "    ax.set_ylim(*ylim)\n",
    "    ax.tick_params(which='both', direction='in', top=True, right=True)\n",
    "    ax.grid(which='both', ls='--', lw=0.3, alpha=0.3)\n",
    "\n",
    "    legend = ax.legend(frameon=False, ncol=2, handlelength=1.2,\n",
