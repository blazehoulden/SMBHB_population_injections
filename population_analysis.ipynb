      "\n",
      "Included simulation families:\n",
      "  - baseline_only\n",
      "  - full_synthetic\n",
      "\n",
      "analysis_binary_df: 1,267,922 binary rows\n",
      "analysis_cgw_sim_df: 1,499 rows\n",
      "analysis_synpta_sim_df: 1,499 rows\n",
      "  analysis_binary_df: 1,499 source files\n",
      "  analysis_cgw_sim_df: 1,499 source files\n",
      "  analysis_synpta_sim_df: 1,499 source files\n"
     ]
