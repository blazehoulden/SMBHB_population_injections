    "\n",
    "colspec = 'l l c c' + (' c' if include_counts else '')\n",
    "lines.append(rf'\\begin{{tabular}}{{{colspec}}}')\n",
    "lines.append(r'\\toprule')\n",
    "\n",
    "header = (\n",
