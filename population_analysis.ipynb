   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import json\n",
    "\n",
    "sky_data = np.load('./data/mpta_pulsar_sky_locations.npz')\n",
    "\n",
    "psr_names = sky_data['names']\n",
    "psr_ra    = sky_data['ras']\n",
    "psr_dec   = sky_data['decs']\n",
    "\n",
    "def angular_separation(ra1, dec1, ra2, dec2):\n",
    "    delta_ra = ra1 - ra2\n",
    "    cos_sep = (np.sin(dec1) * np.sin(dec2)\n",
    "               + np.cos(dec1) * np.cos(dec2) * np.cos(delta_ra))\n",
    "    cos_sep = np.clip(cos_sep, -1.0, 1.0)\n",
    "    return np.arccos(cos_sep)\n",
    "\n",
    "def nearest_pulsar(ra, dec, psr_ra, psr_dec, psr_names):\n",
    "    seps = angular_separation(ra, dec, psr_ra, psr_dec)\n",
    "    idx = np.argmin(seps)\n",
    "    return psr_names[idx], seps[idx]\n",
    "\n",
    "nearest_names = []\n",
    "nearest_seps = []\n",
    "for _, row in df.iterrows():\n",
    "    name, sep = nearest_pulsar(row['loudest_ra'], row['loudest_dec'],\n",
    "                                psr_ra, psr_dec, psr_names)\n",
    "    nearest_names.append(name)\n",
    "    nearest_seps.append(sep)\n",
    "\n",
    "df['nearest_psr_name'] = nearest_names\n",
    "df['nearest_psr_sep_rad'] = nearest_seps\n",
    "df['nearest_psr_sep_deg'] = np.degrees(df['nearest_psr_sep_rad'])\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# NEW: check whether each pulsar has red and/or DM noise in the noise file\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "with open('./meerkat_45yr_noise.json') as f:   # <-- adjust path to your actual NOISEFILE\n",
    "    noise_dict = json.load(f)\n",
    "\n",
    "all_psr_names_in_noisefile = set(k.split('_')[0] for k in noise_dict.keys())\n",
    "\n",
    "def has_lowfreq_noise(psr_name, noise_dict):\n",
    "    \"\"\"Check for either an achromatic red-noise term or a DM-noise term.\"\"\"\n",
    "    has_red = f'{psr_name}_red_log10_A' in noise_dict and f'{psr_name}_red_gamma' in noise_dict\n",
    "    has_dm  = f'{psr_name}_dm_log10_A' in noise_dict and f'{psr_name}_dm_gamma' in noise_dict\n",
    "    return has_red, has_dm\n",
    "\n",
    "# build a lookup table once for every pulsar name that appears as \"nearest\"\n",
    "lookup = {}\n",
    "for name in df['nearest_psr_name'].unique():\n",
    "    has_red, has_dm = has_lowfreq_noise(name, noise_dict)\n",
    "    lookup[name] = {\n",
    "        'has_red': has_red,\n",
    "        'has_dm': has_dm,\n",
    "        'has_any_lowfreq': has_red or has_dm,\n",
    "        'in_noisefile': name in all_psr_names_in_noisefile,\n",
    "    }\n",
    "\n",
    "lookup_df = pd.DataFrame(lookup).T\n",
    "print(\"Per-pulsar low-frequency noise presence (for pulsars appearing as 'nearest'):\")\n",
    "print(lookup_df)\n",
    "\n",
    "df['nearest_has_red']     = df['nearest_psr_name'].map(lambda n: lookup[n]['has_red'])\n",
    "df['nearest_has_dm']      = df['nearest_psr_name'].map(lambda n: lookup[n]['has_dm'])\n",
    "df['nearest_has_lowfreq'] = df['nearest_psr_name'].map(lambda n: lookup[n]['has_any_lowfreq'])\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# check specifically against SNR, now annotated with noise-model status\n",
    "# ---------------------------------------------------------------------------\n",
    "print(\"\\nTop 15 by SNR, annotated:\")\n",
    "print(df.sort_values('loudest_cgw_snr', ascending=False)[\n",
    "    ['loudest_cgw_snr', 'loudest_ra', 'loudest_dec',\n",
    "     'nearest_psr_name', 'nearest_psr_sep_deg',\n",
    "     'nearest_has_red', 'nearest_has_dm', 'nearest_has_lowfreq', 'mode']\n",
    "].head(15))\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# THE ACTUAL TEST: is high SNR specifically concentrated among sources\n",
    "# whose nearest pulsar LACKS red/DM noise, controlling for proximity?\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "# 1. Basic group comparison: SNR distribution split by whether nearest\n",
    "#    pulsar has low-freq noise at all\n",
    "print(\"\\nSNR by nearest-pulsar noise-model status:\")\n",
    "print(df.groupby('nearest_has_lowfreq')['loudest_cgw_snr'].describe())\n",
    "\n",
    "# 2. The critical test: among only the CLOSE sources (small separation,\n",
    "#    where the geometric boost is active for everyone), does missing\n",
    "#    red/DM noise predict the SNR excess? This isolates the noise-model\n",
    "#    effect from the proximity effect.\n",
    "CLOSE_DEG = 3.0\n",
    "close = df[df['nearest_psr_sep_deg'] < CLOSE_DEG]\n",
    "print(f\"\\nAmong {len(close)} sources within {CLOSE_DEG} deg of their nearest pulsar:\")\n",
    "print(close.groupby('nearest_has_lowfreq')['loudest_cgw_snr'].describe())\n",
    "\n",
    "# 3. Statistical test: Mann-Whitney U (non-parametric, robust to the\n",
    "#    heavy-tailed SNR distribution) comparing close-sources-with-noise-term\n",
    "#    vs close-sources-without\n",
    "import numpy as np\n",
    "\n",
    "def mannwhitney_u_numpy(x, y, alternative='two-sided'):\n",
    "    \"\"\"\n",
    "    Numpy-only Mann-Whitney U test via rank-sum, with normal approximation\n",
    "    for the p-value (fine for reasonably sized samples, no tie correction).\n",
    "    \"\"\"\n",
    "    x = np.asarray(x); y = np.asarray(y)\n",
    "    n1, n2 = len(x), len(y)\n",
    "    combined = np.concatenate([x, y])\n",
    "    ranks = np.argsort(np.argsort(combined)) + 1  # average-free simple ranks\n",
    "\n",
    "    # handle ties by averaging ranks (basic version)\n",
    "    order = np.argsort(combined)\n",
    "    ranks_sorted = np.empty(len(combined), dtype=float)\n",
    "    sorted_vals = combined[order]\n",
    "    i = 0\n",
    "    rank = 1\n",
    "    while i < len(sorted_vals):\n",
    "        j = i\n",
    "        while j < len(sorted_vals) and sorted_vals[j] == sorted_vals[i]:\n",
    "            j += 1\n",
    "        avg_rank = (rank + (rank + (j - i) - 1)) / 2.0\n",
    "        ranks_sorted[i:j] = avg_rank\n",
    "        rank += (j - i)\n",
    "        i = j\n",
    "    ranks = np.empty(len(combined), dtype=float)\n",
    "    ranks[order] = ranks_sorted\n",
    "\n",
    "    R1 = ranks[:n1].sum()\n",
    "    U1 = R1 - n1 * (n1 + 1) / 2.0\n",
    "    U2 = n1 * n2 - U1\n",
    "\n",
    "    mu = n1 * n2 / 2.0\n",
    "    sigma = np.sqrt(n1 * n2 * (n1 + n2 + 1) / 12.0)\n",
    "\n",
    "    if alternative == 'greater':\n",
    "        U = U1\n",
    "        z = (U - mu) / sigma\n",
    "    elif alternative == 'less':\n",
    "        U = U1\n",
    "        z = (U - mu) / sigma\n",
    "    else:\n",
    "        U = min(U1, U2)\n",
    "        z = (U - mu) / sigma\n",
    "\n",
    "    from math import erf, sqrt\n",
    "    # normal CDF via erf, no scipy needed\n",
    "    def norm_cdf(x):\n",
    "        return 0.5 * (1 + erf(x / sqrt(2)))\n",
    "\n",
    "    if alternative == 'greater':\n",
    "        pval = 1 - norm_cdf(z)\n",
    "    elif alternative == 'less':\n",
    "        pval = norm_cdf(z)\n",
    "    else:\n",
    "        pval = 2 * min(norm_cdf(z), 1 - norm_cdf(z))\n",
    "\n",
    "    return U1, pval\n",
    "\n",
    "\n",
    "close_no_noise = close[~close['nearest_has_lowfreq']]['loudest_cgw_snr'].to_numpy()\n",
    "close_with_noise = close[close['nearest_has_lowfreq']]['loudest_cgw_snr'].to_numpy()\n",
    "\n",
    "if len(close_no_noise) > 0 and len(close_with_noise) > 0:\n",
    "    U, pval = mannwhitney_u_numpy(close_no_noise, close_with_noise, alternative='greater')\n",
    "    print(f\"n_no_noise={len(close_no_noise)}, n_with_noise={len(close_with_noise)}\")\n",
    "    print(f\"median SNR (no term): {np.median(close_no_noise):.2f}\")\n",
    "    print(f\"median SNR (has term): {np.median(close_with_noise):.2f}\")\n",
    "    print(f\"U-statistic={U:.1f}, p-value≈{pval:.2e}\")\n",
    "else:\n",
    "    print(\"not enough sources in one group\")"
   ]
  },
