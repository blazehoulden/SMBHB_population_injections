    "import numpy as np\n",
    "\n",
    "df = df.rename(columns={'mode': 'run_label'}) if 'run_label' not in df.columns else df\n",
    "df['R'] = df['loudest_cgw_snr'] / df['loudest_h0']\n",
    "\n",
    "log_h0 = np.log10(df['loudest_h0'].to_numpy())\n",
    "\n",
    "counts, edges = np.histogram(log_h0, bins=40)\n",
    "centers = 0.5 * (edges[:-1] + edges[1:])\n",
    "\n",
    "# find the two tallest peaks, then the deepest bin between them\n",
    "sorted_idx = np.argsort(counts)[::-1]\n",
    "peak_bins = sorted(sorted_idx[:2])\n",
    "i_lo, i_hi = peak_bins[0], peak_bins[1]\n",
    "valley_bin = i_lo + np.argmin(counts[i_lo:i_hi+1])\n",
    "split_point = centers[valley_bin]\n",
    "\n",
    "print(f\"peak bins at log10(h0) ~ {centers[peak_bins[0]]:.3f} and {centers[peak_bins[1]]:.3f}\")\n",
    "print(f\"split at log10(h0) = {split_point:.3f}\")\n",
    "\n",
    "df['mode'] = np.where(log_h0 < split_point, 'B', 'A')\n",
    "print(df['mode'].value_counts())"
   ]
  },
