    "\"\"\"\n",
    "Corner plot of loudest CGW event parameters:\n",
    "\n",
    "    fGW, h0, SNR, DL, Mc, SGWB SNR, RA, Dec\n",
    "\n",
    "One corner plot per scenario (lower-triangular 8x8 grid):\n",
    "  - diagonal panels: 1D histogram of each parameter\n",
    "  - off-diagonal panels: pairwise scatter\n",
    "  - fGW, h0, SNR, DL, Mc, SGWB SNR: log-log\n",
    "  - RA, Dec: linear, in radians\n",
    "\n",
    "Uses apply_apj_style()'s rcParams as a baseline, with a local font bump\n",
    "for this dense full-width figure only.\n",
    "\n",
    "Assumes these already exist in your notebook/session:\n",
    "    cgw_threshold_sim_df\n",
    "    scenario_order\n",
    "    scenario_styles\n",
    "    figure_dir\n",
    "    APJ_COL_WIDTH_DOUBLE\n",
    "\n",
    "Required columns:\n",
    "    'scenario'\n",
    "    'loudest_h0'\n",
    "    'loudest_f'\n",
    "    'loudest_DL'\n",
    "    'loudest_cgw_snr'\n",
    "    'loudest_Mc'\n",
    "    'sgwb_snr'\n",
    "    'loudest_ra'\n",
    "    'loudest_dec'\n",
    "\"\"\"\n",
    "\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import matplotlib as mpl\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.ticker as mticker\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Basic checks\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "if cgw_threshold_sim_df.empty:\n",
    "    raise RuntimeError(\n",
    "        'No CGW simulation table available to plot '\n",
    "        '(all simulations below threshold).'\n",
    "    )\n",
    "\n",
    "figure_dir = Path('figures')\n",
    "figure_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Parameter registry\n",
    "#\n",
    "# key -> (column name, axis label, scale, axis limits)\n",
    "#\n",
    "# The first six retain the original log-log treatment.\n",
    "# RA and Dec are linear and remain in radians.\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "PARAMS = {\n",
    "\n",
    "    'h0': (\n",
    "        'loudest_h0',\n",
    "        r'$h_0$',\n",
    "        'log',\n",
    "        None,\n",
    "    ),\n",
    "\n",
    "    'f': (\n",
    "        'loudest_f',\n",
    "        r'$f$ [Hz]',\n",
    "        'log',\n",
    "        None,\n",
    "    ),\n",
    "\n",
    "    'snr': (\n",
    "        'loudest_cgw_snr',\n",
    "        r'$(\\mathrm{S/N})_{\\mathrm{CW}}$',\n",
    "        'log',\n",
    "        None,\n",
    "    ),\n",
    "\n",
    "    'D': (\n",
    "        'loudest_DL',\n",
    "        r'$D_{\\mathrm{L}}$ [Mpc]',\n",
    "        'log',\n",
    "        None,\n",
    "    ),\n",
    "\n",
    "    'Mc': (\n",
    "        'loudest_Mc',\n",
    "        r'$\\mathcal{M}\\ [\\mathrm{M}_\\odot]$',\n",
    "        'log',\n",
    "        None,\n",
    "    ),\n",
    "\n",
    "    'sgwb': (\n",
    "        'sgwb_snr',\n",
    "        r'$(\\mathrm{S/N})_{\\mathrm{SGWB}}$',\n",
    "        'log',\n",
    "        None,\n",
    "    ),\n",
    "\n",
    "    'ra': (\n",
    "        'loudest_ra',\n",
    "        r'$\\mathrm{RA}$ [rad]',\n",
    "        'linear',\n",
    "        (0, 2 * np.pi),\n",
    "    ),\n",
    "\n",
    "    'dec': (\n",
    "        'loudest_dec',\n",
    "        r'$\\mathrm{Dec}$ [rad]',\n",
    "        'linear',\n",
    "        (-np.pi / 2, np.pi / 2),\n",
    "    ),\n",
    "}\n",
    "\n",
    "PARAM_KEYS = [\n",
    "    'h0',\n",
    "    'f',\n",
    "    'snr',\n",
    "    'D',\n",
    "    'Mc',\n",
    "    'sgwb',\n",
    "    'ra',\n",
    "    'dec',\n",
    "]\n",
    "\n",
    "N = len(PARAM_KEYS)\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Check required columns\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "missing_cols = [\n",
    "    PARAMS[k][0]\n",
    "    for k in PARAM_KEYS\n",
    "    if PARAMS[k][0] not in cgw_threshold_sim_df.columns\n",
    "]\n",
    "\n",
    "if missing_cols:\n",
    "    raise KeyError(\n",
    "        f\"cgw_threshold_sim_df is missing columns {missing_cols}. \"\n",
    "        \"Check the RA/Dec column names in PARAMS.\"\n",
    "    )\n",
    "\n",
    "\n",
    "if 'sgwb_snr' not in cgw_threshold_sim_df.columns:\n",
    "    raise KeyError(\n",
    "        \"cgw_threshold_sim_df has no 'sgwb_snr' column -- run the \"\n",
    "        \"SGWB-merge cell first.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Tick helpers\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "def _cap_log_ticks(ax, axis='both', numticks=3):\n",
    "    \"\"\"\n",
    "    Limit major ticks on log axes and suppress minor tick labels.\n",
    "    \"\"\"\n",
    "\n",
    "    if axis in ('x', 'both'):\n",
    "        ax.xaxis.set_major_locator(\n",
    "            mticker.LogLocator(base=10.0, numticks=numticks)\n",
    "        )\n",
    "        ax.xaxis.set_minor_locator(\n",
    "            mticker.LogLocator(\n",
    "                base=10.0,\n",
    "                subs='auto',\n",
    "                numticks=numticks\n",
    "            )\n",
    "        )\n",
    "        ax.xaxis.set_minor_formatter(mticker.NullFormatter())\n",
    "\n",
    "    if axis in ('y', 'both'):\n",
    "        ax.yaxis.set_major_locator(\n",
    "            mticker.LogLocator(base=10.0, numticks=numticks)\n",
    "        )\n",
    "        ax.yaxis.set_minor_locator(\n",
    "            mticker.LogLocator(\n",
    "                base=10.0,\n",
    "                subs='auto',\n",
    "                numticks=numticks\n",
    "            )\n",
    "        )\n",
    "        ax.yaxis.set_minor_formatter(mticker.NullFormatter())\n",
    "\n",
    "\n",
    "def _cap_linear_ticks(ax, axis='both', nbins=4):\n",
    "    \"\"\"\n",
    "    Keep linear angular axes from becoming overloaded with tick labels.\n",
    "    \"\"\"\n",
    "\n",
    "    if axis in ('x', 'both'):\n",
    "        ax.xaxis.set_major_locator(\n",
    "            mticker.MaxNLocator(nbins=nbins)\n",
    "        )\n",
    "\n",
    "    if axis in ('y', 'both'):\n",
    "        ax.yaxis.set_major_locator(\n",
    "            mticker.MaxNLocator(nbins=nbins)\n",
    "        )\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Plot function\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "def plot_corner_scenario(scenario, fname):\n",
    "\n",
    "    sub = cgw_threshold_sim_df[\n",
    "        cgw_threshold_sim_df['scenario'] == scenario\n",
    "    ]\n",
    "\n",
    "    if sub.empty:\n",
    "        print(\n",
    "            f'  skipped {fname} '\n",
    "            f'(no data for scenario={scenario})'\n",
    "        )\n",
    "        return\n",
    "\n",
    "    color = scenario_styles.get(\n",
    "        scenario,\n",
    "        {}\n",
    "    ).get(\n",
    "        'color',\n",
    "        '#888888'\n",
    "    )\n",
    "\n",
    "\n",
    "    # ---------------------------------------------------------------------\n",
    "    # Local style for this dense full-width figure.\n",
    "    #\n",
    "    # 8 parameters means ~0.8-0.9 in per panel at 7 in total width.\n",
    "    # Keep labels/ticks modest rather than trying to use normal body size.\n",
    "    # ---------------------------------------------------------------------\n",
    "\n",
    "    corner_rc = {\n",
    "        'font.size':       9,\n",
    "        'axes.labelsize':  9,\n",
    "        'xtick.labelsize': 7.5,\n",
    "        'ytick.labelsize': 7.5,\n",
    "    }\n",
    "\n",
    "\n",
    "    # Slightly taller than wide so the bottom labels have some room,\n",
    "    # while remaining a sensible full-width ApJ figure.\n",
    "    fig_width = APJ_COL_WIDTH_DOUBLE\n",
    "    fig_height = APJ_COL_WIDTH_DOUBLE\n",
    "\n",
    "\n",
    "    with mpl.rc_context(corner_rc):\n",
    "\n",
    "        fig, axes = plt.subplots(\n",
    "            N,\n",
    "            N,\n",
    "            figsize=(fig_width, fig_height)\n",
    "        )\n",
    "\n",
    "\n",
    "        # -----------------------------------------------------------------\n",
    "        # Loop over panels\n",
    "        # -----------------------------------------------------------------\n",
    "\n",
    "        for i, ykey in enumerate(PARAM_KEYS):\n",
    "\n",
    "            for j, xkey in enumerate(PARAM_KEYS):\n",
    "\n",
    "                ax = axes[i, j]\n",
    "\n",
    "\n",
    "                # ---------------------------------------------------------\n",
    "                # Upper triangle is unused\n",
    "                # ---------------------------------------------------------\n",
    "\n",
    "                if j > i:\n",
    "                    ax.axis('off')\n",
    "                    continue\n",
    "\n",
    "\n",
    "                xcol, xlabel, xscale, xlim = PARAMS[xkey]\n",
    "\n",
    "\n",
    "                # ---------------------------------------------------------\n",
    "                # Diagonal: 1D histogram\n",
    "                # ---------------------------------------------------------\n",
    "\n",
    "                if i == j:\n",
    "\n",
    "                    xvals_raw = sub[xcol]\n",
    "\n",
    "                    if xscale == 'log':\n",
    "                        xvals = xvals_raw[\n",
    "                            xvals_raw > 0\n",
    "                        ].dropna()\n",
    "\n",
    "                    else:\n",
    "                        xvals = xvals_raw.dropna()\n",
    "\n",
    "\n",
    "                    if len(xvals) == 0:\n",
    "\n",
    "                        ax.text(\n",
    "                            0.5,\n",
    "                            0.5,\n",
    "                            'no data',\n",
    "                            ha='center',\n",
    "                            va='center',\n",
    "                            transform=ax.transAxes,\n",
    "                            fontsize=8,\n",
    "                            color='0.5',\n",
    "                        )\n",
    "\n",
    "                        ax.set_xticks([])\n",
    "                        ax.set_yticks([])\n",
    "\n",
    "                    else:\n",
    "\n",
    "                        # -------------------------------------------------\n",
    "                        # Bins\n",
    "                        # -------------------------------------------------\n",
    "\n",
    "                        if xscale == 'log':\n",
    "\n",
    "                            xmin = xvals.min()\n",
    "                            xmax = xvals.max()\n",
    "\n",
    "                            if xmin == xmax:\n",
    "                                xmin *= 0.9\n",
    "                                xmax *= 1.1\n",
    "\n",
    "                            bins = np.logspace(\n",
    "                                np.log10(xmin),\n",
    "                                np.log10(xmax),\n",
    "                                20,\n",
    "                            )\n",
    "\n",
    "                        else:\n",
    "\n",
    "                            lo, hi = (\n",
    "                                xlim\n",
    "                                if xlim is not None\n",
    "                                else (\n",
    "                                    xvals.min(),\n",
    "                                    xvals.max()\n",
    "                                )\n",
    "                            )\n",
    "\n",
    "                            bins = np.linspace(\n",
    "                                lo,\n",
    "                                hi,\n",
    "                                20,\n",
    "                            )\n",
    "\n",
    "\n",
    "                        ax.hist(\n",
    "                            xvals,\n",
    "                            bins=bins,\n",
    "                            color=color,\n",
    "                            alpha=0.7,\n",
    "                            histtype='stepfilled',\n",
    "                        )\n",
    "\n",
    "\n",
    "                        ax.set_xscale(xscale)\n",
    "\n",
    "\n",
    "                        if xlim is not None:\n",
    "                            ax.set_xlim(xlim)\n",
    "\n",
    "\n",
    "                        # Histogram counts aren't useful to show.\n",
    "                        ax.set_yticks([])\n",
    "\n",
    "\n",
    "                        # Tick handling\n",
    "                        if xscale == 'log':\n",
    "                            _cap_log_ticks(\n",
    "                                ax,\n",
    "                                axis='x',\n",
    "                                numticks=3,\n",
    "                            )\n",
    "                        else:\n",
    "                            _cap_linear_ticks(\n",
    "                                ax,\n",
    "                                axis='x',\n",
    "                                nbins=4,\n",
    "                            )\n",
    "\n",
    "\n",
    "                # ---------------------------------------------------------\n",
    "                # Off-diagonal: pairwise scatter\n",
    "                # ---------------------------------------------------------\n",
    "\n",
    "                else:\n",
    "\n",
    "                    ycol, ylabel, yscale, ylim = PARAMS[ykey]\n",
    "\n",
    "\n",
    "                    # x mask\n",
    "                    if xscale == 'log':\n",
    "                        xmask = sub[xcol] > 0\n",
    "                    else:\n",
    "                        xmask = sub[xcol].notna()\n",
    "\n",
    "\n",
    "                    # y mask\n",
    "                    if yscale == 'log':\n",
    "                        ymask = sub[ycol] > 0\n",
    "                    else:\n",
    "                        ymask = sub[ycol].notna()\n",
    "\n",
    "\n",
    "                    mask = xmask & ymask\n",
    "\n",
    "\n",
    "                    if mask.sum() == 0:\n",
    "\n",
    "                        ax.text(\n",
    "                            0.5,\n",
    "                            0.5,\n",
    "                            'no data',\n",
    "                            ha='center',\n",
    "                            va='center',\n",
    "                            transform=ax.transAxes,\n",
    "                            fontsize=8,\n",
    "                            color='0.5',\n",
    "                        )\n",
    "\n",
    "                        ax.set_xticks([])\n",
    "                        ax.set_yticks([])\n",
    "\n",
    "                    else:\n",
    "\n",
    "                        ax.scatter(\n",
    "                            sub.loc[mask, xcol],\n",
    "                            sub.loc[mask, ycol],\n",
    "                            s=3,\n",
    "                            alpha=0.30,\n",
    "                            color=color,\n",
    "                            rasterized=True,\n",
    "                        )\n",
    "\n",
    "\n",
    "                        ax.set_xscale(xscale)\n",
    "                        ax.set_yscale(yscale)\n",
    "\n",
    "\n",
    "                        # Fixed angular limits\n",
    "                        if xlim is not None:\n",
    "                            ax.set_xlim(xlim)\n",
    "\n",
    "                        if ylim is not None:\n",
    "                            ax.set_ylim(ylim)\n",
    "\n",
    "\n",
    "                        # -------------------------------------------------\n",
    "                        # Tick handling\n",
    "                        # -------------------------------------------------\n",
    "\n",
    "                        if xscale == 'log':\n",
    "                            _cap_log_ticks(\n",
    "                                ax,\n",
    "                                axis='x',\n",
    "                                numticks=3,\n",
    "                            )\n",
    "                        else:\n",
    "                            _cap_linear_ticks(\n",
    "                                ax,\n",
    "                                axis='x',\n",
    "                                nbins=4,\n",
    "                            )\n",
    "\n",
    "\n",
    "                        if yscale == 'log':\n",
    "                            _cap_log_ticks(\n",
    "                                ax,\n",
    "                                axis='y',\n",
    "                                numticks=3,\n",
    "                            )\n",
    "                        else:\n",
    "                            _cap_linear_ticks(\n",
    "                                ax,\n",
    "                                axis='y',\n",
    "                                nbins=4,\n",
    "                            )\n",
    "\n",
    "\n",
    "                # ---------------------------------------------------------\n",
    "                # X labels\n",
    "                #\n",
    "                # Only bottom row, standard corner-plot convention.\n",
    "                # ---------------------------------------------------------\n",
    "\n",
    "                ax.tick_params(\n",
    "                    labelbottom=(i == N - 1)\n",
    "                )\n",
    "\n",
    "\n",
    "                if i == N - 1:\n",
    "                    ax.set_xlabel(\n",
    "                        xlabel,\n",
    "                        labelpad=3,\n",
    "                    )\n",
    "\n",
    "\n",
    "                # ---------------------------------------------------------\n",
    "                # Y labels\n",
    "                #\n",
    "                # Only left-most column.\n",
    "                # Diagonal histograms have no useful y-axis.\n",
    "                # ---------------------------------------------------------\n",
    "\n",
    "                if i != j:\n",
    "\n",
    "                    ax.tick_params(\n",
    "                        labelleft=(j == 0)\n",
    "                    )\n",
    "\n",
    "\n",
    "                    if j == 0:\n",
    "\n",
    "                        ax.set_ylabel(\n",
    "                            ylabel,\n",
    "                            labelpad=3,\n",
    "                        )\n",
    "\n",
    "\n",
    "                # ---------------------------------------------------------\n",
    "                # Spines\n",
    "                # ---------------------------------------------------------\n",
    "\n",
    "                for spine in ax.spines.values():\n",
    "                    spine.set_visible(True)\n",
    "\n",
    "\n",
    "        # -----------------------------------------------------------------\n",
    "        # Layout\n",
    "        #\n",
    "        # The 8x8 grid is inherently dense. These values keep the actual\n",
    "        # panels large while leaving just enough room for the outer labels.\n",
    "        # -----------------------------------------------------------------\n",
    "\n",
    "        fig.subplots_adjust(\n",
    "            left=0.095,\n",
    "            right=0.995,\n",
    "            bottom=0.085,\n",
    "            top=0.995,\n",
    "            wspace=0.08,\n",
    "            hspace=0.08,\n",
    "        )\n",
    "\n",
    "\n",
    "        # -----------------------------------------------------------------\n",
    "        # Save\n",
    "        # -----------------------------------------------------------------\n",
    "\n",
    "        fig.savefig(\n",
    "            figure_dir / fname,\n",
    "            dpi=300,\n",
    "        )\n",
    "\n",
    "        plt.show()\n",
    "        plt.close(fig)\n",
    "\n",
    "        print(f'  saved {fname}')\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Generate one corner plot per scenario\n",
    "# -------------------------------------------------------------------------\n",
    "\n",
    "for s in scenario_order:\n",
    "\n",
    "    fname = f'loudest_corner_{s}_thresh.pdf'\n",
    "\n",
    "    plot_corner_scenario(\n",
    "        s,\n",
    "        fname,\n",
    "    )"
   ]
  },
