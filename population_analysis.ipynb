    "import matplotlib.ticker as mticker\n",
    "\n",
    "PTA_DISPLAY = {\n",
    "    'baseline':                  'Fiducial (4.5 yr)',\n",
    "    'baseline_forecast':         'Fiducial (9.0 yr)',\n",
    "    '2x_precision':              r'$2 \\times$ Precision',\n",
    "    '2x_precision_conserved':    r'$2 \\times$ Precision (TT Cons.)',\n",
    "    '4x_cadence':                r'$4 \\times$ Cadence',\n",
    "    '4x_cadence_conserved':      r'$4 \\times$ Cadence (TT Cons.)',\n",
    "    '4x_cad_2x_prec':            r'Combined',\n",
    "    '4x_cad_2x_prec_conserved':  r'Combined (TT Cons.)',\n",
    "    'max_cadence_top10':         r'Max. Cadence -- Top 10',\n",
    "    'max_cadence_top20':         r'Max. Cadence -- Top 20',\n",
    "    'max_cadence_top30':         r'Max. Cadence -- Top 30',\n",
    "    'max_cadence_top40':         r'Max. Cadence -- Top 40',\n",
    "}\n",
    "\n",
    "BASELINE_SNR_COL = 'loudest_cgw_snr_baseline_forecast'  # default reference\n",
    "                                                          # for most panels\n",
    "TRUE_BASELINE_SNR_COL = 'loudest_cgw_snr'                # the actual 4.5 yr\n",
    "                                                          # fiducial column\n",
    "\n",
    "# Per-label overrides for the reference column. baseline_forecast must be\n",
    "# compared against the true fiducial, not against itself (which is what\n",
    "# BASELINE_SNR_COL points to) — otherwise the delta is trivially zero.\n",
    "REFERENCE_COL_OVERRIDES = {\n",
    "    'baseline_forecast': TRUE_BASELINE_SNR_COL,\n",
    "}\n",
    "\n",
    "\n",
    "def make_symlog_bins(all_vals, linthresh=1e-3, bins_per_decade=8, linear_bins=40):\n",
    "    \"\"\"Bin edges that are log-spaced above/below +/- linthresh, with a\n",
    "    finer linear region spanning zero. Matches ax.set_xscale('symlog', ...).\n",
    "\n",
    "    `linear_bins` controls resolution in [-linthresh, +linthresh] — bump\n",
    "    this up if deltas are densely clustered near zero.\n",
    "    \"\"\"\n",
    "    all_vals = np.asarray(all_vals, dtype=float)\n",
    "    all_vals = all_vals[np.isfinite(all_vals)]\n",
    "\n",
    "    pos = all_vals[all_vals > linthresh]\n",
    "    neg = all_vals[all_vals < -linthresh]\n",
    "\n",
    "    edge_parts = []\n",
    "\n",
    "    if neg.size:\n",
    "        neg_abs_max = np.max(-neg)\n",
    "        n_bins = max(int(np.ceil(bins_per_decade * np.log10(neg_abs_max / linthresh))), 1)\n",
    "        neg_edges = -np.logspace(np.log10(neg_abs_max), np.log10(linthresh), n_bins + 1)\n",
    "        edge_parts.append(neg_edges)\n",
    "\n",
    "    edge_parts.append(np.linspace(-linthresh, linthresh, linear_bins + 1))\n",
    "\n",
    "    if pos.size:\n",
    "        pos_max = np.max(pos)\n",
    "        if pos_max > linthresh:\n",
    "            n_bins = max(int(np.ceil(bins_per_decade * np.log10(pos_max / linthresh))), 1)\n",
    "            pos_edges = np.logspace(np.log10(linthresh), np.log10(pos_max), n_bins + 1)\n",
    "            edge_parts.append(pos_edges)\n",
    "\n",
    "    return np.unique(np.concatenate(edge_parts))\n",
    "\n",
    "\n",
    "for label, field in zip(synthetic_pta_labels, synthetic_snr_fields):\n",
    "    syn_col = f'loudest_{field}'\n",
    "    if syn_col not in synpta_sim_df.columns:\n",
    "        print(f'  {syn_col!r} missing — skipping {label}')\n",
    "        continue\n",
    "\n",
    "    ref_col = REFERENCE_COL_OVERRIDES.get(label, BASELINE_SNR_COL)\n",
    "    if ref_col not in synpta_sim_df.columns:\n",
    "        print(f'  reference column {ref_col!r} missing — skipping {label}')\n",
    "        continue\n",
    "\n",
    "    pta_title = PTA_DISPLAY.get(label, label)  # human-readable version of this panel's PTA\n",
    "    \n",
    "    # ── pass 1: collect each population's delta array ─────────────────\n",
    "    pop_deltas = {}\n",
    "    pop_scenarios = pop_scenarios[::-1]\n",
    "    for pop in pop_scenarios:\n",
    "        sub = synpta_sim_df[synpta_sim_df['scenario'] == pop]\n",
    "        if sub.empty:\n",
    "            continue\n",
    "        paired = sub[[syn_col, ref_col]].dropna()\n",
    "        if paired.empty:\n",
    "            continue\n",
    "        delta = (paired[syn_col] - paired[ref_col]).to_numpy(float)\n",
    "        delta = delta[np.isfinite(delta)]\n",
    "        if delta.size:\n",
    "            pop_deltas[pop] = delta\n",
    "\n",
    "    if not pop_deltas:\n",
    "        print(f'  no matched sims — skipping {pta_title}')\n",
    "        continue\n",
    "\n",
    "    pooled = np.concatenate(list(pop_deltas.values()))\n",
    "    bin_edges = make_symlog_bins(pooled, linthresh=1e-3, bins_per_decade=8, linear_bins=20)\n",
    "\n",
    "    # ── pass 2: plot ────────────────────────────────────────────────────\n",
    "    fig, ax = plt.subplots(figsize=(3.5, 2.8))\n",
    "    for pop, delta in pop_deltas.items():\n",
    "        st = _SYNPTA_POP_STYLES.get(pop, {'color': '#888', 'linestyle': '-', 'linewidth': 1.5})\n",
    "        lo, med, hi = np.percentile(delta, [2.5, 50, 97.5])\n",
    "        pop_label = _SYNPTA_LABEL_MAP.get(pop, pop)\n",
    "        print(f'  {pta_title:<28} {pop_label:<12}  Δmedian={med:+.3g}  '\n",
    "              f'95% CI=({lo:+.3g}, {hi:+.3g})  N={len(delta)}')\n",
    "        ax.hist(delta, bins=bin_edges, histtype='step',\n",
    "                color=st['color'], linestyle=st['linestyle'],\n",
    "                linewidth=st['linewidth'], density=False, zorder=2,\n",
    "                label=SCENARIO_MASS_MAP.get(pop, pop_label))\n",
    "\n",
    "    # ax.axvline(0.0, color='black', linestyle='--', linewidth=1.2, zorder=3)\n",
    "    ax.set_title(pta_title, fontweight='bold')\n",
    "    ax.set_xlabel(r'$\\Delta\\,(\\mathrm{S/N})_{\\rm CW}$ (observing strategy $-$ fiducial)')\n",
    "    ax.set_ylabel('Number of simulations')\n",
    "    ax.set_xscale('log')\n",
    "    # ax.set_xscale('symlog', linthresh=1e-3, linscale=1.0)\n",
    "    # ax.xaxis.set_minor_locator(\n",
    "    #     mticker.SymmetricalLogLocator(base=10, linthresh=1e-3, subs=np.arange(2, 10))\n",
    "    # )\n",
    "    # ax.set_xlim(-1e-3, 10)\n",
    "    ax.spines['top'].set_visible(True)\n",
    "    ax.spines['right'].set_visible(True)\n",
    "    # ax.legend(loc='best', frameon=False, handlelength=1.3,\n",
    "    #           handletextpad=0.5, labelspacing=0.3, fontsize='medium')\n",
    "    fig.tight_layout()\n",
    "\n",
    "    out_path = Path('figures') / f'synpta_{label}_cw_snr_delta.pdf'\n",
    "    fig.savefig(out_path, dpi=300, bbox_inches='tight')\n",
    "    plt.close(fig)\n",
    "    print(f'  saved {out_path}')"
   ]
