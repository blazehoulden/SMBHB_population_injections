    "    'baseline_forecast': 'Fiducial (9.0 yr)',\n",
    "    '2x_precision':      'Fiducial (4.5 yr) +\\n' + r'$2\\times$ Precision (4.5 yr)',\n",
    "    '4x_cadence':        'Fiducial (4.5 yr) +\\n' + r'$4\\times$ Cadence (4.5 yr)',\n",
    "    '4x_cad_2x_prec':    'Fiducial (4.5 yr) + \\n Combined (4.5 yr)',\n",
    "    '4x_cad_4x_prec':    'Fiducial (4.5 yr) Combined (4x/4x)',\n",
    "    'max_cadence_top10': 'Fiducial (4.5 yr) +\\n' + r'Max Cadence (Top 10)',\n",
