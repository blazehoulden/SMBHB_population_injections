     "text": [
      "Synthetic PTA labels used for classification:\n",
      "  ['2x_precision', '2x_precision_conserved', '4x_cad_2x_prec', '4x_cad_2x_prec_conserved', '4x_cadence', '4x_cadence_conserved', 'cgw_weighted_cadence', 'max_cadence_top10', 'max_cadence_top20', 'max_cadence_top30', 'max_cadence_top40']\n",
      "\n",
      "Required synthetic PTA fields:\n",
      "  ['cgw_snr_2x_precision', 'cgw_snr_2x_precision_conserved', 'cgw_snr_4x_cad_2x_prec', 'cgw_snr_4x_cad_2x_prec_conserved', 'cgw_snr_4x_cadence', 'cgw_snr_4x_cadence_conserved', 'cgw_snr_cgw_weighted_cadence', 'cgw_snr_max_cadence_top10', 'cgw_snr_max_cadence_top20', 'cgw_snr_max_cadence_top30', 'cgw_snr_max_cadence_top40']\n",
      "\n",
      "Simulation-file classification:\n",
      "simulation_family\n",
      "full_synthetic    1499\n",
      "baseline_only     1085\n",
      "\n",
