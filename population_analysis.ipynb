    "else:\n",
    "    ref_field = synthetic_snr_fields[synthetic_pta_labels.index(REF_LABEL)]\n",
    "    pop_scenarios = [s for s in ('pessimistic', 'realistic', 'optimistic')\n",
    "                     if s in synpta_sim_df['scenario'].unique()]\n",
    "\n",
    "    keys = [k for k in MATCH_KEYS if k in synpta_sim_df.columns]\n",
    "    if len(keys) < len(MATCH_KEYS):\n",
    "        print('WARNING: match keys missing; aligning by row order within scenario.')\n",
    "        base_df = synpta_sim_df.copy()\n",
    "        base_df['_row'] = base_df.groupby('scenario').cumcount()\n",
    "        keys = ['scenario', '_row']\n",
    "    else:\n",
    "        base_df = synpta_sim_df\n",
    "\n",
    "    ref_cols = base_df[keys + [f'{ref_field}_f', f'loudest_{ref_field}']].rename(\n",
    "        columns={f'{ref_field}_f': 'f_ref', f'loudest_{ref_field}': 'snr_ref'})\n",
    "\n",
    "    summary = {}   # label -> {pop: (n_changed, n_total)}\n",
    "\n",
    "    for label, field in zip(synthetic_pta_labels, synthetic_snr_fields):\n",
    "        if label == REF_LABEL:\n",
    "            continue\n",
    "\n",
    "        syn = base_df[keys + [f'{field}_f', f'loudest_{field}']].rename(\n",
    "            columns={f'{field}_f': 'f_syn', f'loudest_{field}': 'snr_syn'})\n",
    "        m = syn.merge(ref_cols, on=keys, how='inner')\n",
    "        m = m[m['snr_syn'] >= CGW_SNR_THRESHOLD].copy()      # detected in new strategy\n",
    "        m['f_ref_n']  = m['f_ref'] * 1e9                     # nHz\n",
    "        m['f_syn_n']  = m['f_syn'] * 1e9\n",
    "        m['changed']  = np.abs(m['f_syn_n'] - m['f_ref_n']) > TOL_NHZ\n",
    "        m['ref_det']  = m['snr_ref'] >= CGW_SNR_THRESHOLD\n",
    "        m = m[np.isfinite(m['f_ref_n']) & np.isfinite(m['f_syn_n'])]\n",
    "        m = m[(m['f_ref_n'] > 0) & (m['f_syn_n'] > 0)]\n",
    "        if m.empty:\n",
    "            continue\n",
    "\n",
    "        summary[label] = {p: (int(m.loc[m.scenario == p, 'changed'].sum()),\n",
    "                              int((m.scenario == p).sum())) for p in pop_scenarios}\n",
    "\n",
    "        # ── 1:1 plot ───────────────────────────────────────────────\n",
    "        fig, ax = plt.subplots(figsize=(3.5, 3.2))\n",
    "        lo = min(m['f_ref_n'].min(), m['f_syn_n'].min()) * 0.8\n",
    "        hi = max(m['f_ref_n'].max(), m['f_syn_n'].max()) * 1.25\n",
    "        ax.plot([lo, hi], [lo, hi], color='black', ls='--', lw=1.0, zorder=1)\n",
    "\n",
    "        for pop in pop_scenarios:\n",
    "            s = m[m['scenario'] == pop]\n",
    "            if s.empty:\n",
    "                continue\n",
    "            col = _SYNPTA_POP_STYLES.get(pop, _DEF_STYLE)['color']\n",
    "\n",
    "            same = s[~s['changed']]\n",
    "            ax.scatter(same['f_ref_n'], same['f_syn_n'], s=10, color=col,\n",
    "                       alpha=0.35, linewidths=0, zorder=2)\n",
    "\n",
    "            for det_ref, mk in ((True, 'o'), (False, '^')):\n",
    "                ch = s[s['changed'] & (s['ref_det'] == det_ref)]\n",
    "                ax.scatter(ch['f_ref_n'], ch['f_syn_n'], s=32, marker=mk,\n",
    "                           color=col, edgecolor='black', linewidths=0.7, zorder=3)\n",
    "\n",
    "        ax.set_xscale('log'); ax.set_yscale('log')\n",
    "        ax.set_xlim(lo, hi);  ax.set_ylim(lo, hi)\n",
    "        ax.set_aspect('equal', adjustable='box')\n",
    "        ax.set_xlabel(r'$f$ — Fiducial (9.0 yr) [nHz]')\n",
    "        ax.set_ylabel(rf'$f$ — {PTA_DISPLAY.get(label, label)} [nHz]')\n",
    "        ax.spines['top'].set_visible(True); ax.spines['right'].set_visible(True)\n",
    "\n",
    "        if label == '2x_precision':\n",
    "            # Legend 1: scenario colours, bottom right, tucked against the side\n",
    "            color_handles = [\n",
    "                mlines.Line2D([], [], color=_SYNPTA_POP_STYLES.get(p, _DEF_STYLE)['color'],\n",
    "                              marker='o', ls='', ms=5,\n",
    "                              label=SCENARIO_MASS_MAP.get(p, _SYNPTA_LABEL_MAP.get(p, p)))\n",
    "                for p in pop_scenarios\n",
    "            ]\n",
    "            leg_colors = ax.legend(\n",
    "                handles=color_handles,\n",
    "                loc='lower right', bbox_to_anchor=(1.0, 0.2),\n",
    "                borderaxespad=0.1,\n",
    "                frameon=False, fontsize='small',\n",
    "                handletextpad=0.3, labelspacing=0.3,\n",
    "            )\n",
    "            ax.add_artist(leg_colors)   # keep it when the second legend is created\n",
    "\n",
    "            # Legend 2: grey marker meanings, upper left\n",
    "            grey_handles = [\n",
    "                mlines.Line2D([], [], color='grey', marker='o', mec='black', ls='', ms=6,\n",
    "                              label='Frequency changed'),\n",
    "                mlines.Line2D([], [], color='grey', marker='^', mec='black', ls='', ms=6,\n",
    "                              label='Not detected in fiducial'),\n",
    "            ]\n",
    "            ax.legend(\n",
    "                handles=grey_handles,\n",
    "                loc='lower right',\n",
    "                frameon=False, fontsize='small',\n",
    "                handletextpad=0.3, labelspacing=0.3,\n",
    "            )\n",
    "        ax.set_title(PTA_DISPLAY.get(label, label), fontweight='bold')\n",
    "        fig.tight_layout()\n",
    "        out_path = Path('figures') / f'synpta_{label}_f_vs_fiducial.pdf'\n",
    "        fig.savefig(out_path, dpi=300, bbox_inches='tight')\n",
    "        plt.close(fig)\n",
    "        print(f'saved {out_path}   ' +\n",
    "              '  '.join(f'{_SYNPTA_LABEL_MAP.get(p, p)}: {a}/{b} changed'\n",
    "                        for p, (a, b) in summary[label].items()))\n",
    "\n",
    "    # ── summary: fraction of detected binaries whose f changed ─────\n",
    "    if summary:\n",
    "        labels = list(summary.keys())\n",
    "        x = np.arange(len(labels))\n",
    "        w = 0.8 / len(pop_scenarios)\n",
    "        fig, ax = plt.subplots(figsize=(1.0 * len(labels) + 1.5, 2.8))\n",
    "        for i, pop in enumerate(pop_scenarios):\n",
    "            frac = [100 * summary[l][pop][0] / max(summary[l][pop][1], 1) for l in labels]\n",
    "            ax.bar(x + (i - (len(pop_scenarios) - 1) / 2) * w, frac, w,\n",
    "                   color=_SYNPTA_POP_STYLES.get(pop, _DEF_STYLE)['color'],\n",
    "                   label=SCENARIO_MASS_MAP.get(pop, _SYNPTA_LABEL_MAP.get(pop, pop)))\n",
    "        ax.set_xticks(x)\n",
    "        ax.set_xticklabels([PTA_DISPLAY.get(l, l) for l in labels],\n",
    "                           rotation=35, ha='right', fontsize='small')\n",
    "        ax.set_ylabel('Binaries with changed $f$ [%]')\n",
    "        ax.legend(frameon=False, fontsize='small')\n",
    "        ax.spines['top'].set_visible(True); ax.spines['right'].set_visible(True)\n",
    "        fig.tight_layout()\n",
    "        out_path = Path('figures') / 'synpta_f_changed_fraction_summary.pdf'\n",
    "        fig.savefig(out_path, dpi=300, bbox_inches='tight')\n",
    "        plt.close(fig)\n",
    "        print(f'saved {out_path}')"
   ]
  },
