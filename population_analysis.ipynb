    "            if not isinstance(arrays, dict):\n",
    "                continue\n",
    "            for k in arrays:\n",
    "                if k.startswith('cgw_snr_'):\n",
    "                    found.add(k)\n",
    "        except Exception:\n",
    "            pass\n",
