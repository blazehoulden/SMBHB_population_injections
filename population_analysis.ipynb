   "source": [
    "# ============================================================================\n",
    "# Detectable loudest-source parameter fractions\n",
    "# ============================================================================\n",
    "#\n",
    "# Uses the same detectability definition as the notebook:\n",
    "#\n",
    "#     loudest_cgw_snr_baseline_forecast >= CGW_SNR_THRESHOLD\n",
    "#\n",
    "# where CGW_SNR_THRESHOLD is normally 5.94.\n",
    "#\n",
    "# The analysis is performed on cgw_sim_df, which contains one loudest source\n",
    "# per simulation and scenario.\n",
    "#\n",
    "# Set any parameter bound to None to ignore that bound.\n",
    "# Bounds are inclusive.\n",
    "# ============================================================================\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "\n",
    "if \"cgw_sim_df\" not in globals():\n",
    "    raise NameError(\n",
    "        \"cgw_sim_df is not defined. Run the earlier CGW-analysis cells first.\"\n",
    "    )\n",
    "\n",
    "# Use the notebook's existing threshold if available.\n",
    "if \"CGW_SNR_THRESHOLD\" not in globals():\n",
    "    CGW_SNR_THRESHOLD = 5.94\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# User settings\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "# Optional filters. Set to None to include all configurations/scenarios.\n",
    "config_filter = None          # e.g. \"realistic\"\n",
    "scenario_filter = None        # e.g. \"baseline_forecast\"\n",
    "\n",
    "# Source-property cuts.\n",
    "#\n",
    "# Frequency is specified in nHz.\n",
    "two_year_period = 2.0 * 365.25 * 24 * 3600  # seconds in 2 years\n",
    "orb_freq_nhz = 1.0e9 / two_year_period\n",
    "frequency_min_nhz = 2 * orb_freq_nhz\n",
    "# frequency_min_nhz = 20.0\n",
    "frequency_max_nhz = None\n",
    "\n",
    "# Chirp mass is specified in solar masses.\n",
    "chirp_mass_min_msun = 2e9\n",
    "chirp_mass_max_msun = None\n",
    "\n",
    "# Strain amplitude is dimensionless.\n",
    "h0_min = None\n",
    "h0_max = None\n",
    "\n",
    "# Comoving distance is specified in Mpc.\n",
    "distance_min_mpc = None\n",
    "distance_max_mpc = None\n",
    "\n",
    "# Redshift is dimensionless.\n",
    "redshift_min = None\n",
    "redshift_max = None\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Validate the expected loudest-source table\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "df = cgw_sim_df.copy()\n",
    "\n",
    "required_columns = {\n",
    "    \"scenario\",\n",
    "    \"loudest_cgw_snr_baseline_forecast\",\n",
    "    \"loudest_f\",\n",
    "    \"loudest_Mc\",\n",
    "    \"loudest_h0\",\n",
    "}\n",
    "\n",
    "missing_columns = sorted(required_columns - set(df.columns))\n",
    "if missing_columns:\n",
    "    raise KeyError(\n",
    "        \"cgw_sim_df is missing required columns:\\n\"\n",
    "        f\"  {missing_columns}\\n\\n\"\n",
    "        f\"Available columns are:\\n  {list(df.columns)}\"\n",
    "    )\n",
    "\n",
    "if config_filter is not None:\n",
    "    if \"config\" not in df.columns:\n",
    "        raise KeyError(\n",
    "            \"config_filter was set, but cgw_sim_df has no 'config' column.\"\n",
    "        )\n",
    "    df = df.loc[df[\"config\"].eq(config_filter)].copy()\n",
    "\n",
    "if scenario_filter is not None:\n",
    "    df = df.loc[df[\"scenario\"].eq(scenario_filter)].copy()\n",
    "\n",
    "if df.empty:\n",
    "    raise ValueError(\"No rows remain after applying config/scenario filters.\")\n",
    "\n",
    "# Avoid counting duplicate records for the same simulation/scenario.\n",
    "deduplication_columns = [\n",
    "    column for column in [\"sim_key\", \"sim_index\", \"scenario\"]\n",
    "    if column in df.columns\n",
    "]\n",
    "\n",
    "if deduplication_columns:\n",
    "    df = df.drop_duplicates(\n",
    "        subset=deduplication_columns,\n",
    "        keep=\"last\",\n",
    "    ).copy()\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Standardise numeric columns\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "numeric_columns = [\n",
    "    \"loudest_cgw_snr_baseline_forecast\",\n",
    "    \"loudest_f\",\n",
    "    \"loudest_Mc\",\n",
    "    \"loudest_h0\",\n",
    "]\n",
    "\n",
    "for optional_column in [\n",
    "    \"loudest_D\",\n",
    "    \"loudest_D_comov\",\n",
    "    \"loudest_distance\",\n",
    "    \"loudest_z\",\n",
    "]:\n",
    "    if optional_column in df.columns:\n",
    "        numeric_columns.append(optional_column)\n",
    "\n",
    "for column in numeric_columns:\n",
    "    df[column] = pd.to_numeric(df[column], errors=\"coerce\")\n",
    "\n",
    "# Stored frequencies are in Hz; use nHz for the user-facing cuts.\n",
    "df[\"_loudest_frequency_nhz\"] = df[\"loudest_f\"] * 1e9\n",
    "\n",
    "# Accommodate the distance-column name used by different notebook/result\n",
    "# formats.\n",
    "distance_column = next(\n",
    "    (\n",
    "        column for column in [\n",
    "            \"loudest_D\",\n",
    "            \"loudest_D_comov\",\n",
    "            \"loudest_distance\",\n",
    "        ]\n",
    "        if column in df.columns\n",
    "    ),\n",
    "    None,\n",
    ")\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Build detectability and parameter masks\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "# This intentionally matches the notebook's earlier detection analysis.\n",
    "# NaN S/N values are not detectable.\n",
    "detectable_mask = (\n",
    "    df[\"loudest_cgw_snr_baseline_forecast\"].notna()\n",
    "    & (\n",
    "        df[\"loudest_cgw_snr_baseline_forecast\"]\n",
    "        >= CGW_SNR_THRESHOLD\n",
    "    )\n",
    ")\n",
    "\n",
    "parameter_mask = pd.Series(True, index=df.index)\n",
    "\n",
    "\n",
    "def apply_lower_bound(mask, values, lower):\n",
    "    if lower is not None:\n",
    "        mask &= values >= lower\n",
    "    return mask\n",
    "\n",
    "\n",
    "def apply_upper_bound(mask, values, upper):\n",
    "    if upper is not None:\n",
    "        mask &= values <= upper\n",
    "    return mask\n",
    "\n",
    "\n",
    "parameter_mask = apply_lower_bound(\n",
    "    parameter_mask,\n",
    "    df[\"_loudest_frequency_nhz\"],\n",
    "    frequency_min_nhz,\n",
    ")\n",
    "parameter_mask = apply_upper_bound(\n",
    "    parameter_mask,\n",
    "    df[\"_loudest_frequency_nhz\"],\n",
    "    frequency_max_nhz,\n",
    ")\n",
    "\n",
    "parameter_mask = apply_lower_bound(\n",
    "    parameter_mask,\n",
    "    df[\"loudest_Mc\"],\n",
    "    chirp_mass_min_msun,\n",
    ")\n",
    "parameter_mask = apply_upper_bound(\n",
    "    parameter_mask,\n",
    "    df[\"loudest_Mc\"],\n",
    "    chirp_mass_max_msun,\n",
    ")\n",
    "\n",
    "parameter_mask = apply_lower_bound(\n",
    "    parameter_mask,\n",
    "    df[\"loudest_h0\"],\n",
    "    h0_min,\n",
    ")\n",
    "parameter_mask = apply_upper_bound(\n",
    "    parameter_mask,\n",
    "    df[\"loudest_h0\"],\n",
    "    h0_max,\n",
    ")\n",
    "\n",
    "if distance_min_mpc is not None or distance_max_mpc is not None:\n",
    "    if distance_column is None:\n",
    "        raise KeyError(\n",
    "            \"A distance cut was requested, but no loudest-source distance \"\n",
    "            \"column was found.\"\n",
    "        )\n",
    "\n",
    "    parameter_mask = apply_lower_bound(\n",
    "        parameter_mask,\n",
    "        df[distance_column],\n",
    "        distance_min_mpc,\n",
    "    )\n",
    "    parameter_mask = apply_upper_bound(\n",
    "        parameter_mask,\n",
    "        df[distance_column],\n",
    "        distance_max_mpc,\n",
    "    )\n",
    "\n",
    "if redshift_min is not None or redshift_max is not None:\n",
    "    if \"loudest_z\" not in df.columns:\n",
    "        raise KeyError(\n",
    "            \"A redshift cut was requested, but 'loudest_z' is unavailable.\"\n",
    "        )\n",
    "\n",
    "    parameter_mask = apply_lower_bound(\n",
    "        parameter_mask,\n",
    "        df[\"loudest_z\"],\n",
    "        redshift_min,\n",
    "    )\n",
    "    parameter_mask = apply_upper_bound(\n",
    "        parameter_mask,\n",
    "        df[\"loudest_z\"],\n",
    "        redshift_max,\n",
    "    )\n",
    "\n",
    "# A simulation is counted when:\n",
    "#   1. its loudest source is detectable according to the notebook threshold;\n",
    "#   2. that detectable source satisfies all requested parameter cuts.\n",
    "detectable_and_matching_mask = detectable_mask & parameter_mask\n",
    "\n",
    "df[\"_detectable\"] = detectable_mask\n",
    "df[\"_matches_parameter_cuts\"] = parameter_mask\n",
    "df[\"_detectable_and_matches\"] = detectable_and_matching_mask\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Summarise by scenario\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "def safe_fraction(numerator, denominator):\n",
    "    return float(numerator / denominator) if denominator else np.nan\n",
    "\n",
    "\n",
    "summary_rows = []\n",
    "\n",
    "for scenario, group in df.groupby(\"scenario\", dropna=False, sort=True):\n",
    "    n_simulations = len(group)\n",
    "    n_detectable = int(group[\"_detectable\"].sum())\n",
    "    n_matching_detectable = int(\n",
    "        group[\"_detectable_and_matches\"].sum()\n",
    "    )\n",
    "    n_matching_all = int(group[\"_matches_parameter_cuts\"].sum())\n",
    "\n",
    "    summary_rows.append({\n",
    "        \"scenario\": scenario,\n",
    "        \"n_simulations\": n_simulations,\n",
    "        \"n_detectable\": n_detectable,\n",
    "        \"n_matching_detectable\": n_matching_detectable,\n",
    "        \"n_matching_all\": n_matching_all,\n",
    "\n",
    "        # Detection fraction using the notebook's S/N threshold.\n",
    "        \"detection_fraction\": safe_fraction(\n",
    "            n_detectable,\n",
    "            n_simulations,\n",
    "        ),\n",
    "\n",
    "        # Main requested result:\n",
    "        # fraction of detectable simulations whose loudest source satisfies\n",
    "        # the requested frequency/mass/etc. cuts.\n",
    "        \"fraction_detectable_matching\": safe_fraction(\n",
    "            n_matching_detectable,\n",
    "            n_detectable,\n",
    "        ),\n",
    "\n",
    "        # Same quantity as a percentage.\n",
    "        \"percent_detectable_matching\": (\n",
    "            100.0 * safe_fraction(\n",
    "                n_matching_detectable,\n",
    "                n_detectable,\n",
    "            )\n",
    "            if n_detectable\n",
    "            else np.nan\n",
    "        ),\n",
    "\n",
    "        # Fraction of all simulations, including non-detections, satisfying\n",
    "        # both detectability and the requested parameter cuts.\n",
    "        \"fraction_all_matching\": safe_fraction(\n",
    "            n_matching_detectable,\n",
    "            n_simulations,\n",
    "        ),\n",
    "\n",
    "        \"percent_all_matching\": (\n",
    "            100.0 * safe_fraction(\n",
    "                n_matching_detectable,\n",
    "                n_simulations,\n",
    "            )\n",
    "            if n_simulations\n",
    "            else np.nan\n",
    "        ),\n",
    "    })\n",
    "\n",
    "parameter_fraction_summary = pd.DataFrame(summary_rows)\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Display the result\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "print(\"Detectability criterion:\")\n",
    "print(\n",
    "    \"  loudest_cgw_snr_baseline_forecast \"\n",
    "    f\">= {CGW_SNR_THRESHOLD}\"\n",
    ")\n",
    "\n",
    "print(\"\\nRequested loudest-source parameter cuts:\")\n",
    "print(\n",
    "    f\"  frequency [nHz]:   >= {frequency_min_nhz}, \"\n",
    "    f\"<= {frequency_max_nhz}\"\n",
    ")\n",
    "print(\n",
    "    f\"  chirp mass [Msun]: >= {chirp_mass_min_msun}, \"\n",
    "    f\"<= {chirp_mass_max_msun}\"\n",
    ")\n",
    "print(f\"  h0:                >= {h0_min}, <= {h0_max}\")\n",
    "print(\n",
    "    f\"  distance [Mpc]:    >= {distance_min_mpc}, \"\n",
    "    f\"<= {distance_max_mpc}\"\n",
    ")\n",
    "print(\n",
    "    f\"  redshift:          >= {redshift_min}, \"\n",
    "    f\"<= {redshift_max}\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    parameter_fraction_summary[\n",
    "        [\n",
    "            \"scenario\",\n",
    "            \"n_simulations\",\n",
    "            \"n_detectable\",\n",
    "            \"n_matching_detectable\",\n",
    "            \"detection_fraction\",\n",
    "            \"fraction_detectable_matching\",\n",
    "            \"percent_detectable_matching\",\n",
    "            \"fraction_all_matching\",\n",
    "            \"percent_all_matching\",\n",
    "        ]\n",
    "    ].style.format({\n",
    "        \"detection_fraction\": \"{:.3f}\",\n",
    "        \"fraction_detectable_matching\": \"{:.3f}\",\n",
    "        \"percent_detectable_matching\": \"{:.2f}%\",\n",
    "        \"fraction_all_matching\": \"{:.3f}\",\n",
    "        \"percent_all_matching\": \"{:.2f}%\",\n",
    "    })\n",
    ")\n",
    "\n",
    "# ---------------------------------------------------------------------------\n",
    "# Show the individual matching detectable simulations\n",
    "# ---------------------------------------------------------------------------\n",
    "\n",
    "matching_columns = [\n",
    "    column for column in [\n",
    "        \"scenario\",\n",
    "        \"config\",\n",
    "        \"sim_key\",\n",
    "        \"sim_index\",\n",
    "        \"loudest_cgw_snr_baseline_forecast\",\n",
    "        \"_loudest_frequency_nhz\",\n",
    "        \"loudest_Mc\",\n",
    "        \"loudest_h0\",\n",
    "        \"loudest_D\",\n",
    "        \"loudest_z\",\n",
    "    ]\n",
    "    if column in df.columns\n",
    "]\n",
    "\n",
    "matching_detectable_simulations = (\n",
    "    df.loc[\n",
    "        detectable_and_matching_mask,\n",
    "        matching_columns,\n",
    "    ]\n",
    "    .sort_values(\n",
    "        [\"scenario\", \"loudest_cgw_snr_baseline_forecast\"],\n",
    "        ascending=[True, False],\n",
    "    )\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nMatching detectable simulations: \"\n",
    "    f\"{len(matching_detectable_simulations)} / {len(df)} total rows\"\n",
    ")\n",
    "\n",
    "display(matching_detectable_simulations)"
   ]
  },
