   "source": [
    "import numpy as np\n",
    "\n",
    "G = 6.67430e-11\n",
    "C = 2.99792458e8\n",
    "MSUN = 1.98892e30\n",
    "MPC = 3.0856775814913673e22\n",
    "\n",
    "def h0_formula(f_obs_hz, Mc_msun, D_comov_mpc, z):\n",
    "    f_rest = 0.5 * (1.0 + z) * f_obs_hz\n",
    "    Mc_SI = Mc_msun * MSUN\n",
    "    D_SI = D_comov_mpc * MPC\n",
    "    return (2.0 * (G * Mc_SI)**(5.0/3.0)\n",
    "                * (2.0 * np.pi * f_rest)**(2.0/3.0)\n",
    "                / (C**4 * D_SI))\n",
    "\n",
    "df['h0_recomputed'] = h0_formula(\n",
    "    df['loudest_f'], df['loudest_Mc'], df['loudest_D'], df['loudest_z']\n",
    ")\n",
    "df['h0_ratio'] = df['loudest_h0'] / df['h0_recomputed']\n",
    "\n",
    "print(df.groupby('mode')['h0_ratio'].describe())"
   ]
  },
