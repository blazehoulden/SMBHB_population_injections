    "    '2x_precision', '2x_precision_conserved',\n",
    "    '4x_cadence', '4x_cadence_conserved',\n",
    "    '4x_cad_2x_prec', '4x_cad_2x_prec_conserved',\n",
    "    'max_cadence_top10', 'max_cadence_top20',\n",
    "    'max_cadence_top30', 'max_cadence_top40',\n",
    "    'cgw_weighted_cadence',\n",
    "]\n",
    "\n",
    "# ── % of sims where the loudest (S/N)_CW source differs from the 9-yr baseline ──\n",
    "# Requires change_df from the diagnostic cell.\n",
    "def pct_source_changed(pop, pta):\n",
    "    \"\"\"Return % of sims in `pop` whose loudest source differs from the\n",
    "    baseline_forecast loudest source, or np.nan if unavailable.\"\"\"\n",
    "    col = f'{pta}_source_changed'\n",
    "    if 'change_df' not in globals() or change_df.empty or col not in change_df.columns:\n",
    "        return np.nan\n",
    "    vals = change_df.loc[change_df['scenario'] == pop, col].dropna()\n",
    "    if len(vals) == 0:\n",
    "        return np.nan\n",
    "    return 100.0 * vals.astype(bool).mean()\n",
    "\n",
    "def fmt_pct_2sf(x):\n",
    "    \"\"\"Format a percentage to two significant figures: 35, 6.5, 0.65, 100.\"\"\"\n",
    "    if x is None or not np.isfinite(x):\n",
    "        return r'---'\n",
    "    if x == 0:\n",
    "        return '0'\n",
    "    if x >= 99.5:\n",
    "        return '100'\n",
    "    r = x\n",
    "    for _ in range(2):  # re-check in case rounding bumps the magnitude (9.96 -> 10)\n",
    "        mag = int(np.floor(np.log10(r)))\n",
    "        dec = max(1 - mag, 0)\n",
    "        r = round(x, dec)\n",
    "    return f'{r:.{dec}f}'\n",
    "\n",
    "lines = []\n",
    "\n",
    "include_counts = False   # set True to add a \"Detected / Total\" column\n",
    "\n",
    "lines = []\n",
